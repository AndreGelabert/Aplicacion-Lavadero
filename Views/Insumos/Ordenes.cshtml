@model List<Firebase.Models.OrdenCompra>
@{ ViewData["Title"] = "Órdenes de compra"; }
<section class="bg-gray-50 dark:bg-gray-900">
<div class="mx-auto bg-white dark:bg-gray-800 shadow-md sm:rounded-lg p-4">
    <div class="flex flex-wrap justify-between items-center gap-2 mb-4">
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Órdenes de compra</h1>
        <a asp-action="Index" class="app-button app-button--secondary"><svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>Volver</a>
    </div>
    @if (User.TienePermiso("Insumos.Crear") && User.TienePermiso("Insumos.Modificar"))
    {
        <p class="mb-4 text-sm text-gray-600 dark:text-gray-300">Para una compra nueva, <a asp-action="Cotizaciones" class="text-blue-600 underline">solicite una cotización</a>. Las repeticiones recientes elegibles se preparan para aprobación.</p>
    }
    <div class="overflow-x-auto" role="region" aria-label="Tabla de órdenes" tabindex="0">
    <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400" data-finite-table>
        <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400"><tr><th class="px-4 py-3 select-none"><button type="button" data-sort-column="0" data-sort-type="date" class="flex items-center gap-1">Fecha <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3l4 5H6l4-5zm0 14-4-5h8l-4 5z" /></svg></button></th><th class="px-4 py-3 select-none"><button type="button" data-sort-column="1" class="flex items-center gap-1">Proveedor <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 3l4 5H6l4-5zm0 14-4-5h8l-4 5z" /></svg></button></th><th class="px-4 py-3">Estado</th><th class="px-4 py-3">Acciones</th></tr></thead>
        <tbody>
        @foreach (var o in Model)
        {
            <tr class="border-b dark:border-gray-700 align-top">
                <td class="px-4 py-3" data-sort-value="@o.FechaEmision.ToUniversalTime().ToString("O")">@o.FechaEmision.ToLocalTime().ToString("g")</td><td class="px-4 py-3">@o.ProveedorId</td><td class="px-4 py-3"><span class="@(o.Estado == "Recibida" ? "bg-green-100 text-green-800" : o.Estado == "Cancelada" ? "bg-red-100 text-red-800" : o.Estado == "Enviada" || o.Estado == "PendienteAprobacion" ? "bg-yellow-100 text-yellow-800" : "bg-blue-100 text-blue-800") text-xs font-medium px-2.5 py-0.5 rounded-full">@o.Estado</span></td>
                <td class="px-4 py-3">
                    <button type="button" data-open-modal="order-modal-@o.Id" class="p-1.5 text-white bg-blue-600 rounded-lg hover:bg-blue-700" aria-label="Ver detalle de orden"><svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zm10-3a3 3 0 100 6 3 3 0 000-6z" /></svg></button>
                </td></tr>
        }
        </tbody></table></div>
        @foreach (var o in Model) {
        <div id="order-modal-@o.Id" data-order-modal role="dialog" aria-modal="true" aria-hidden="true" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50"><div class="relative p-4 w-full max-w-2xl max-h-full overflow-y-auto bg-white dark:bg-gray-800 rounded-lg shadow-lg"><button type="button" data-close-modal class="float-right text-gray-500" aria-label="Cerrar">✕</button><h2 class="text-lg font-semibold dark:text-white">Detalle de la orden</h2>
                        <div class="space-y-3 mt-3 text-gray-700 dark:text-gray-300">
                            <p class="font-medium">Orden @o.Id</p><p>@o.Notas</p>
                            <ul class="list-disc pl-5">@foreach (var item in o.Items) { <li>@item.NombreInsumo: @item.Cantidad (recibido: @item.CantidadRecibida), precio: @item.PrecioUnitario</li> }</ul>
                            @if (o.Estado == "PendienteAprobacion" && User.TienePermiso("Insumos.Modificar"))
                            {
                                <p>El precio histórico es una referencia; el precio y la disponibilidad requieren confirmación del proveedor.</p>
                                <form method="post" asp-action="AprobarOrden">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id" /><button type="submit" class="app-button app-button--success"><svg aria-hidden="true" class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12l4 4L19 6" /></svg>Aprobar y enviar</button></form>
                                @foreach (var item in o.Items)
                                {
                                    <form method="post" asp-action="EditarOrdenPendiente" class="grid gap-2 border-t pt-2 dark:border-gray-700">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id" /><input type="hidden" name="insumoId" value="@item.InsumoId" /><span>@item.NombreInsumo</span>
                                        <label>Cantidad <input name="cantidad" type="number" min="0.0001" step="0.0001" value="@item.Cantidad.ToString(System.Globalization.CultureInfo.InvariantCulture)" required class="block w-full rounded border p-2 dark:bg-gray-700" /></label>
                                        <label>Precio <input name="precio" type="number" min="0" step="0.0001" value="@item.PrecioUnitario.ToString(System.Globalization.CultureInfo.InvariantCulture)" required class="block w-full rounded border p-2 dark:bg-gray-700" /></label>
                                        <div><button type="submit" class="app-button app-button--secondary"><svg aria-hidden="true" class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1-9 3 3-9 9H9v-3z" /></svg>Editar orden</button></div>
                                    </form>
                                }
                            }
                            @if (o.Estado == "RevisionManual") { <p>Resultado de envío incierto: requiere revisión manual. No se reenviará automáticamente.</p> }
                            @if (User.TienePermiso("Insumos.Modificar") && o.Estado == "Enviada") { <form method="post" asp-action="CambiarEstadoOrden">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id" /><input type="hidden" name="estado" value="Confirmada" /><button class="app-button app-button--secondary"><svg aria-hidden="true" class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12l4 4L19 6" /></svg>Confirmar</button></form> }
                            @if (User.TienePermiso("Insumos.Modificar") && o.Estado == "Confirmada") { <form method="post" asp-action="CambiarEstadoOrden">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id" /><input type="hidden" name="estado" value="Despachada" /><button class="app-button app-button--secondary"><svg aria-hidden="true" class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7h12v10H3zM15 10h3l3 3v4h-6M7 20a2 2 0 100-4 2 2 0 000 4zm11 0a2 2 0 100-4 2 2 0 000 4z" /></svg>Despachar</button></form> }
                            @if (User.TienePermiso("Insumos.Recepcionar") && (o.Estado == "Enviada" || o.Estado == "Confirmada" || o.Estado == "Despachada"))
                            {
                                <form method="post" asp-action="RecibirOrden" class="space-y-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id" />
                                    @foreach (var item in o.Items) { <div><input type="hidden" name="insumoIds" value="@item.InsumoId" /><label class="text-xs">@item.NombreInsumo (pend. @(item.Cantidad - item.CantidadRecibida)) <input name="cantidades" type="number" min="0" max="@(item.Cantidad - item.CantidadRecibida)" step="0.0001" value="@(item.Cantidad - item.CantidadRecibida)" class="block w-full rounded border p-2 dark:bg-gray-700" /></label></div> }
                                    @if (!string.IsNullOrWhiteSpace(o.GrupoCotizacionId)) { <label class="block"><input type="checkbox" name="cancelarConcurrentes" value="true" /> Cancelar órdenes concurrentes al completar la recepción</label> }
                                    <button class="app-button app-button--success"><svg aria-hidden="true" class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12l4 4L19 6" /></svg>Registrar recepción</button>
                                </form>
                            }
                            @if (User.TienePermiso("Insumos.Modificar") && o.Estado != "Recibida" && o.Estado != "Cancelada")
                            {
                                <form method="post" asp-action="CambiarEstadoOrden" class="space-y-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id" /><input type="hidden" name="estado" value="Cancelada" /><label>Motivo <input name="motivo" required class="block w-full rounded border p-2 dark:bg-gray-700" /></label><button class="app-button app-button--secondary"><svg aria-hidden="true" class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" /></svg>Cancelar orden</button></form>
                            }
                        </div>
                    </div></div>
        }
</div></section>
<script src="~/js/insumos-secondary.js" asp-append-version="true"></script>
