@model List<Firebase.Models.OrdenCompra>
@{ ViewData["Title"] = "Órdenes de compra"; }
@if (User.TienePermiso("Insumos.Crear") && User.TienePermiso("Insumos.Modificar")) {
<p class="bg-white dark:bg-gray-800 rounded-lg p-4 mb-4">Para una compra nueva, <a asp-action="Cotizaciones" class="text-blue-600">solicite una cotización</a>. Las repeticiones recientes elegibles se preparan para aprobación.</p>
}
@foreach (var orden in Model) { <details class="p-2"><summary>Detalle de orden @orden.Id</summary><p>@orden.Notas</p><ul>@foreach (var item in orden.Items) { <li>@item.NombreInsumo: @item.Cantidad (recibido: @item.CantidadRecibida), precio: @item.PrecioUnitario</li> }</ul>
@if (orden.Estado == "PendienteAprobacion" && User.TienePermiso("Insumos.Modificar")) {
<p>El precio histórico es una referencia; el precio y la disponibilidad requieren confirmación del proveedor.</p>
<form method="post" asp-action="AprobarOrden">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@orden.Id" /><button type="submit">Aprobar y enviar</button></form>
@foreach (var item in orden.Items) { <form method="post" asp-action="EditarOrdenPendiente">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@orden.Id" /><input type="hidden" name="insumoId" value="@item.InsumoId" /><span>@item.NombreInsumo</span> <label>Cantidad <input name="cantidad" type="number" min="0.0001" step="0.0001" value="@item.Cantidad.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label> <label>Precio <input name="precio" type="number" min="0" step="0.0001" value="@item.PrecioUnitario.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label> <button type="submit">Editar orden</button></form> }
}
@if (orden.Estado == "RevisionManual") { <p>Resultado de envío incierto: requiere revisión manual. No se reenviará automáticamente.</p> }</details> }
<section class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow"><div class="flex justify-between mb-4"><h1 class="text-2xl font-semibold dark:text-white">Órdenes de compra</h1><a asp-action="Index" class="text-blue-600">Volver</a></div><table class="w-full text-sm"><thead><tr class="border-b"><th class="text-left p-2">Fecha</th><th>Proveedor</th><th>Estado</th><th></th></tr></thead><tbody>@foreach (var o in Model) { <tr class="border-b align-top"><td class="p-2">@o.FechaEmision.ToLocalTime().ToString("g")</td><td>@o.ProveedorId</td><td>@o.Estado</td><td class="flex gap-2">@if (User.TienePermiso("Insumos.Modificar") && o.Estado == "Enviada") { <form method="post" asp-action="CambiarEstadoOrden">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id" /><input type="hidden" name="estado" value="Confirmada" /><button class="text-blue-600">Confirmar</button></form> } @if (User.TienePermiso("Insumos.Modificar") && o.Estado == "Confirmada") { <form method="post" asp-action="CambiarEstadoOrden">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id" /><input type="hidden" name="estado" value="Despachada" /><button class="text-indigo-600">Despachar</button></form> } @if (User.TienePermiso("Insumos.Recepcionar") && (o.Estado == "Enviada" || o.Estado == "Confirmada" || o.Estado == "Despachada")) { <form method="post" asp-action="RecibirOrden" class="space-y-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id" /> @foreach (var item in o.Items) { <div><input type="hidden" name="insumoIds" value="@item.InsumoId" /><label class="text-xs">@item.NombreInsumo (pend. @(item.Cantidad - item.CantidadRecibida))</label><input name="cantidades" type="number" min="0" max="@(item.Cantidad - item.CantidadRecibida)" step="0.0001" value="@(item.Cantidad - item.CantidadRecibida)" class="w-24 rounded border p-1" /></div> }@if (!string.IsNullOrWhiteSpace(o.GrupoCotizacionId)) { <label><input type="checkbox" name="cancelarConcurrentes" value="true" /> Cancelar órdenes concurrentes al completar la recepción</label> }<button class="text-green-600">Registrar recepción</button></form> } @if (User.TienePermiso("Insumos.Modificar") && o.Estado != "Recibida" && o.Estado != "Cancelada") { <form method="post" asp-action="CambiarEstadoOrden">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id" /><input type="hidden" name="estado" value="Cancelada" /><input name="motivo" required placeholder="Motivo" class="w-32 rounded border p-1" /><button class="text-red-600">Cancelar</button></form> }</td></tr> }</tbody></table></section>
