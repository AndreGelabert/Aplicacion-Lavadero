@model List<Firebase.Models.Proveedor>
@{ ViewData["Title"] = "Proveedores"; var puedeAdministrar = (bool?)ViewBag.PuedeAdministrar == true; var puedeCrear = User.TienePermiso("Insumos.Crear"); }
<section class="bg-gray-50 dark:bg-gray-900"><div class="mx-auto bg-white dark:bg-gray-800 relative shadow-md sm:rounded-lg overflow-visible">
<div class="p-2 flex justify-between items-center rounded-t border-b dark:border-gray-600"><h1 class="text-2xl font-semibold dark:text-white">Proveedores</h1><a asp-action="Index" class="app-button app-button--secondary">Volver</a></div>
@if (puedeAdministrar) {
<div id="accordion-flush" data-accordion="collapse"><h2><button type="button" class="flex items-center justify-between w-full p-2 py-5 font-medium text-gray-500 border-b dark:border-gray-700 gap-3" data-accordion-target="#provider-body" aria-expanded="false" aria-controls="provider-body"><span id="provider-title">@(puedeCrear ? "Registrando un Proveedor" : "Editar Proveedor")</span><svg data-accordion-icon class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 10 6"><path stroke="currentColor" stroke-width="2" d="M9 5 5 1 1 5" /></svg></button></h2>
<div id="provider-body" class="hidden"><form id="provider-form" method="post" asp-action="GuardarProveedor" data-can-create="@puedeCrear.ToString().ToLowerInvariant()">@Html.AntiForgeryToken()<input type="hidden" name="crear" value="true" /><input type="hidden" name="Id" />
<div class="grid gap-4 m-4 grid-cols-1 sm:grid-cols-2">
<label class="block text-sm font-medium dark:text-white">CUIT / identificación <span class="text-red-600">*</span><input name="IdentificacionTributaria" required class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:text-white" /></label>
<label class="block text-sm font-medium dark:text-white">Razón social <span class="text-red-600">*</span><input name="RazonSocial" required class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:text-white" /></label>
<label class="block text-sm font-medium dark:text-white">Contacto<input name="Contacto" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:text-white" /></label>
<label class="block text-sm font-medium dark:text-white">Email de órdenes<input name="EmailOrdenes" type="email" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:text-white" /></label></div>
<div class="flex justify-end gap-2 m-4"><button type="submit" class="app-button app-button--primary">Guardar</button><button type="button" data-provider-reset class="app-button app-button--secondary">Cancelar</button></div></form></div></div>
}
<div class="overflow-x-auto" role="region" aria-label="Tabla de proveedores" tabindex="0"><table class="w-full text-sm text-left text-gray-500 dark:text-gray-400" data-finite-table><thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400"><tr><th class="px-4 py-3 select-none"><button type="button" data-sort-column="0" class="flex items-center gap-1">Razón social <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 3l4 5H6l4-5zm0 14-4-5h8l-4 5z" /></svg></button></th><th class="px-4 py-3">Identificación</th><th class="px-4 py-3">Email</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3">Acciones</th></tr></thead><tbody>
@foreach (var p in Model) { <tr class="border-b dark:border-gray-700"><td class="px-4 py-3">@p.RazonSocial</td><td class="px-4 py-3">@p.IdentificacionTributaria</td><td class="px-4 py-3">@p.EmailOrdenes</td><td class="px-4 py-3"><span class="@(p.Estado == "Activo" ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800") text-xs font-medium px-2.5 py-0.5 rounded-full">@p.Estado</span></td><td class="px-4 py-3"><div class="flex gap-2">
@if (User.TienePermiso("Insumos.Modificar")) { <button type="button" data-provider-edit data-id="@p.Id" data-tax="@p.IdentificacionTributaria" data-name="@p.RazonSocial" data-contact="@p.Contacto" data-email="@p.EmailOrdenes" aria-label="Editar proveedor" title="Editar" class="p-1.5 text-white bg-blue-600 rounded-lg hover:bg-blue-700"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="1.5" d="M16 4l4 4L7 21H3v-4z" /></svg></button> }
@if (puedeAdministrar) { <button type="button" data-provider-state data-id="@p.Id" data-name="@p.RazonSocial" data-state="@(p.Estado == "Activo" ? "Inactivo" : "Activo")" aria-label="@(p.Estado == "Activo" ? "Desactivar" : "Reactivar") proveedor" class="p-1.5 text-white @(p.Estado == "Activo" ? "bg-red-600" : "bg-green-600") rounded-lg"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M6 6l12 12M18 6L6 18" /></svg></button> }
</div></td></tr> }
</tbody></table></div>
@if (puedeAdministrar) { <div id="provider-confirm" role="dialog" aria-modal="true" aria-hidden="true" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50"><div class="relative p-4 w-full max-w-md bg-white dark:bg-gray-800 rounded-lg shadow-lg sm:p-5 text-center"><div class="w-12 h-12 rounded-full bg-red-100 p-2 flex items-center justify-center mx-auto mb-3.5 text-red-600">✕</div><h3 id="provider-confirm-title" class="text-lg font-semibold dark:text-white"></h3><p id="provider-confirm-message" class="text-sm dark:text-gray-300 mb-4"></p><form method="post" asp-action="EstadoProveedor">@Html.AntiForgeryToken()<input type="hidden" name="id" /><input type="hidden" name="estado" /><button type="button" data-close-modal class="py-2 px-3 bg-white border rounded-lg">Cancelar</button> <button id="provider-confirm-submit" type="submit" class="py-2 px-3 text-white bg-red-600 rounded-lg">Desactivar</button></form></div></div> }
</div></section><script src="~/js/insumos-secondary.js" asp-append-version="true"></script>
