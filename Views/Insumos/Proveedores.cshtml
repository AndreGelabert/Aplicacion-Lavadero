@model List<Firebase.Models.Proveedor>
@{ ViewData["Title"] = "Proveedores"; var puedeAdministrar = (bool?)ViewBag.PuedeAdministrar == true; var puedeCrear = User.TienePermiso("Insumos.Crear"); }
<section class="bg-gray-50 dark:bg-gray-900"><div class="mx-auto bg-white dark:bg-gray-800 relative shadow-md sm:rounded-lg overflow-visible">
<div class="p-2 flex justify-between items-center rounded-t border-b dark:border-gray-600"><h1 class="text-2xl font-semibold dark:text-white">Proveedores</h1><div class="flex items-center gap-2"><a asp-action="Index" class="text-white inline-flex items-center bg-gray-600 hover:bg-gray-700 focus:ring-4 focus:outline-none focus:ring-gray-300 font-medium rounded-lg text-sm px-3 py-2 text-center dark:bg-gray-500 dark:hover:bg-gray-600 dark:focus:ring-gray-800"><svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
                    </svg>
                    Volver a Insumos</a><button data-popover-target="providers-help" data-popover-trigger="click" data-popover-placement="bottom" type="button" aria-label="Ayuda" class="text-white inline-flex items-center bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-2 py-2 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z"></path></svg></button><div data-popover id="providers-help" role="tooltip" class="absolute z-10 invisible inline-block w-64 text-sm text-gray-500 transition-opacity duration-300 bg-white border border-gray-200 rounded-lg shadow-xs opacity-0 dark:text-gray-400 dark:border-gray-600 dark:bg-gray-800"><div class="px-3 py-2 bg-gray-100 border-b border-gray-200 rounded-t-lg dark:border-gray-600 dark:bg-gray-700"><h3 class="font-semibold text-gray-900 dark:text-white">Ayuda</h3></div><div class="px-3 py-2"><p>En esta página puedes consultar los proveedores y su estado. Según tus permisos, puedes registrar o editar sus datos de contacto y cambiar su estado desde las acciones de la tabla.</p></div><div data-popper-arrow></div></div></div></div>
@if (puedeAdministrar) {
<div id="accordion-flush" data-accordion="collapse" data-active-classes="bg-white dark:bg-gray-900 text-gray-900 dark:text-white" data-inactive-classes="text-gray-500 dark:text-gray-400"><h2><button type="button" class="flex items-center w-full p-2 py-5 font-medium text-gray-500 border-b dark:border-gray-700 gap-3" data-accordion-target="#provider-body" aria-expanded="false" aria-controls="provider-body"><span id="provider-title">@(puedeCrear ? "Registrando un Proveedor" : "Editar Proveedor")</span><svg data-accordion-icon class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 10 6"><path stroke="currentColor" stroke-width="2" d="M9 5 5 1 1 5" /></svg></button></h2>
<div id="provider-body" class="hidden"><form id="provider-form" data-validate="true" method="post" asp-action="GuardarProveedor" data-can-create="@puedeCrear.ToString().ToLowerInvariant()">@Html.AntiForgeryToken()<input type="hidden" name="crear" value="true" /><input type="hidden" name="Id" />
<div class="grid gap-4 m-4 grid-cols-1 sm:grid-cols-2">
<div><label for="provider-tax-id" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">CUIT / identificación <span class="text-red-600">*</span></label><input id="provider-tax-id" name="IdentificacionTributaria" placeholder="20-12345678-9" required class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:text-white" /><p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Formato: XX-XXXXXXXX-X o 11 dígitos</p></div>
<label class="block text-sm font-medium dark:text-white">Razón social <span class="text-red-600">*</span><input name="RazonSocial" placeholder="Ej: Distribuidora Química S.A." required class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:text-white" /></label>
<div><label for="provider-phone" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Teléfono <span class="text-red-600">*</span></label><input id="provider-phone" name="Contacto" type="tel" pattern="[0-9]{10}" title="Debe contener exactamente 10 dígitos" placeholder="1123456789" required class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:text-white" /><p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Exactamente 10 dígitos</p></div>
<div><label for="provider-email" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Email de órdenes <span class="text-red-600">*</span></label><input id="provider-email" name="EmailOrdenes" type="email" placeholder="ventas@proveedor.com" required class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:text-white disabled:opacity-60 disabled:cursor-not-allowed" /><input id="provider-original-email" type="hidden" disabled /><p id="provider-email-lock-note" class="hidden mt-1 text-xs text-gray-500 dark:text-gray-400">No se puede cambiar el email mientras existan solicitudes u órdenes activas.</p></div></div>
<div class="flex justify-end gap-2 m-4"><button type="submit" class="app-button app-button--success"><svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-8"><path d="M2.25 12a9.75 9.75 0 1 1 19.5 0 9.75 9.75 0 0 1-19.5 0Zm13.36-1.814a.75.75 0 0 0-1.22-.872l-3.236 4.53-1.624-1.624a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094z" /></svg>Guardar</button><button type="button" data-provider-reset class="app-button app-button--danger"><svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-8"><path d="M12 2.25a9.75 9.75 0 1 0 0 19.5 9.75 9.75 0 0 0 0-19.5ZM9.22 9.22a.75.75 0 0 1 1.06 0L12 10.94l1.72-1.72a.75.75 0 1 1 1.06 1.06L13.06 12l1.72 1.72a.75.75 0 1 1-1.06 1.06L12 13.06l-1.72 1.72a.75.75 0 0 1-1.06-1.06L10.94 12 9.22 10.28a.75.75 0 0 1 0-1.06Z" /></svg><span id="provider-reset-label">Limpiar campos</span></button></div></form></div></div>
}
<div class="overflow-x-auto" role="region" aria-label="Tabla de proveedores" tabindex="0"><table class="w-full text-sm text-left text-gray-500 dark:text-gray-400" data-finite-table><thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400"><tr><th class="px-4 py-3 select-none"><button type="button" data-sort-column="0" class="flex items-center gap-1">Razón social <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 3l4 5H6l4-5zm0 14-4-5h8l-4 5z" /></svg></button></th><th class="px-4 py-3">Identificación</th><th class="px-4 py-3">Email</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3">Acciones</th></tr></thead><tbody>
@foreach (var p in Model) { <tr class="border-b dark:border-gray-700"><td class="px-4 py-3">@p.RazonSocial</td><td class="px-4 py-3">@p.IdentificacionTributaria</td><td class="px-4 py-3">@p.EmailOrdenes</td><td class="px-4 py-3"><span class="@(p.Estado == "Activo" ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800") text-xs font-medium px-2.5 py-0.5 rounded">@p.Estado</span></td><td class="px-4 py-3"><div class="flex gap-2">
@if (User.TienePermiso("Insumos.Modificar")) { <button type="button" data-provider-edit data-id="@p.Id" data-tax="@p.IdentificacionTributaria" data-name="@p.RazonSocial" data-contact="@p.Contacto" data-email="@p.EmailOrdenes" data-email-ordenes-bloqueado="@p.EmailOrdenesBloqueado.ToString().ToLowerInvariant()" aria-label="Editar proveedor" title="Editar" class="p-1.5 text-white bg-blue-600 rounded-lg hover:bg-blue-700"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125"></path></svg></button> }
@if (puedeAdministrar) { <button type="button" data-provider-state data-id="@p.Id" data-name="@p.RazonSocial" data-state="@(p.Estado == "Activo" ? "Inactivo" : "Activo")" aria-label="@(p.Estado == "Activo" ? "Desactivar" : "Reactivar") proveedor" class="p-1.5 text-white @(p.Estado == "Activo" ? "bg-red-600" : "bg-green-600") rounded-lg"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">@if (p.Estado == "Activo") { <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"></path> } else { <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path> }</svg></button> }
</div></td></tr> }
</tbody></table></div>
@if (puedeAdministrar) { <div id="provider-confirm" role="dialog" aria-modal="true" aria-hidden="true" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50"><div class="relative p-4 w-full max-w-md bg-white dark:bg-gray-800 rounded-lg shadow-lg sm:p-5 text-center"><div class="w-12 h-12 rounded-full bg-red-100 p-2 flex items-center justify-center mx-auto mb-3.5 text-red-600">✕</div><h3 id="provider-confirm-title" class="text-lg font-semibold dark:text-white"></h3><p id="provider-confirm-message" class="text-sm dark:text-gray-300 mb-4"></p><form method="post" asp-action="EstadoProveedor">@Html.AntiForgeryToken()<input type="hidden" name="id" /><input type="hidden" name="estado" /><div class="flex justify-end gap-2"><button id="provider-confirm-submit" type="submit" class="app-button app-button--success"><svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-8" aria-hidden="true"><path d="M2.25 12a9.75 9.75 0 1 1 19.5 0 9.75 9.75 0 0 1-19.5 0Zm13.36-1.814a.75.75 0 0 0-1.22-.872l-3.236 4.53-1.624-1.624a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094z" /></svg><span>Desactivar</span></button><button type="button" data-close-modal class="app-button app-button--danger"><svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-8" aria-hidden="true"><path d="M12 2.25a9.75 9.75 0 1 0 0 19.5 9.75 9.75 0 0 0 0-19.5ZM9.22 9.22a.75.75 0 0 1 1.06 0L12 10.94l1.72-1.72a.75.75 0 1 1 1.06 1.06L13.06 12l1.72 1.72a.75.75 0 1 1-1.06 1.06L12 13.06l-1.72 1.72a.75.75 0 0 1-1.06-1.06L10.94 12 9.22 10.28a.75.75 0 0 1 0-1.06Z" /></svg>Cancelar</button></div></form></div></div> }
</div></section><script src="~/js/form-validation.js" asp-append-version="true"></script><script src="~/js/insumos-secondary.js" asp-append-version="true"></script>
