@model List<Firebase.Models.Proveedor>
@{ ViewData["Title"] = "Proveedores"; var puedeAdministrar = (bool?)ViewBag.PuedeAdministrar == true; }
<section class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow">
    <div class="flex justify-between mb-4"><h1 class="text-2xl font-semibold dark:text-white">Proveedores</h1><a asp-action="Index" class="text-blue-600">Volver a insumos</a></div>
    @if (puedeAdministrar) { <form method="post" asp-action="GuardarProveedor" class="grid md:grid-cols-5 gap-2 mb-5">@Html.AntiForgeryToken()<input type="hidden" name="crear" value="true" /><input name="IdentificacionTributaria" required placeholder="CUIT / identificación" class="rounded border p-2" /><input name="RazonSocial" required placeholder="Razón social" class="rounded border p-2" /><input name="Contacto" placeholder="Contacto" class="rounded border p-2" /><input name="EmailOrdenes" type="email" placeholder="Email de órdenes" class="rounded border p-2" /><button class="app-button app-button--success">Agregar</button></form> }
    <table class="w-full text-sm"><thead><tr class="border-b"><th class="text-left p-2">Razón social</th><th class="text-left p-2">Identificación</th><th class="text-left p-2">Email</th><th></th></tr></thead><tbody>
    @foreach (var p in Model) { <tr class="border-b"><td class="p-2">@p.RazonSocial</td><td>@p.IdentificacionTributaria</td><td>@p.EmailOrdenes</td><td>@if (User.TienePermiso("Insumos.Modificar")) { <details><summary class="cursor-pointer text-blue-600">Editar</summary><form method="post" asp-action="GuardarProveedor" class="mt-2 grid gap-2">@Html.AntiForgeryToken()<input type="hidden" name="crear" value="false" /><input type="hidden" name="Id" value="@p.Id" /><label>Identificación fiscal <input name="IdentificacionTributaria" value="@p.IdentificacionTributaria" readonly class="rounded border p-2" /></label><label>Razón social <input name="RazonSocial" value="@p.RazonSocial" required class="rounded border p-2" /></label><label>Contacto <input name="Contacto" value="@p.Contacto" class="rounded border p-2" /></label><label>Email de órdenes <input name="EmailOrdenes" type="email" value="@p.EmailOrdenes" class="rounded border p-2" /></label><button class="app-button app-button--success">Guardar</button></form></details> } @if (puedeAdministrar) { <form method="post" asp-action="EstadoProveedor">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id" /><input type="hidden" name="estado" value="@(p.Estado == "Activo" ? "Inactivo" : "Activo")" /><button class="text-orange-600">@(p.Estado == "Activo" ? "Desactivar" : "Reactivar")</button></form> }</td></tr> }
    </tbody></table>
</section>
