@model Firebase.Models.Insumo
@{
    var proveedores = (ViewBag.Proveedores as List<Firebase.Models.Proveedor>) ?? new();
    var tipos = (ViewBag.Tipos as List<Firebase.Models.TipoInsumo>) ?? new();
    var puedeCrear = User.TienePermiso("Insumos.Crear");
}
<form id="insumo-form" method="post" asp-action="Guardar" data-can-create="@puedeCrear.ToString().ToLowerInvariant()" class="m-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="crear" value="true" /><input type="hidden" name="Id" /><input type="hidden" name="Tipo" /><input type="hidden" name="TipoId" disabled /><input type="hidden" name="UnidadMedida" disabled />
    <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
        <div><label for="insumoNombre" class="block mb-2 text-sm font-medium dark:text-white">Nombre <span class="text-red-600">*</span></label><input id="insumoNombre" name="Nombre" placeholder="Ej: Shampoo siliconado concentrado" required class="bg-gray-50 border border-gray-300 rounded-lg w-full p-2.5 dark:bg-gray-700 dark:text-white" /></div>
        <div><label for="insumoTipo" class="block mb-2 text-sm font-medium dark:text-white">Tipo de Insumo <span class="text-red-600">*</span></label><div class="flex"><select id="insumoTipo" name="TipoId" required class="min-w-0 bg-gray-50 border border-gray-300 rounded-lg w-full p-2.5 dark:bg-gray-700 dark:text-white" onchange="window.actualizarUnidadesInsumo(this)"><option value="">Seleccionar tipo</option>@foreach (var tipo in tipos) { <option value="@tipo.Id" data-categoria="@tipo.Categoria">@tipo.Nombre</option> }</select>
            @if (puedeCrear) { <button type="button" data-modal-target="tiposInsumoModal" data-open-tipos aria-label="Crear tipo" class="ml-2 px-2 text-white bg-blue-600 rounded-lg">+</button> }
            @if (User.TienePermiso("Insumos.Modificar") && puedeCrear) { <button type="button" data-delete-tipo aria-label="Desactivar tipo seleccionado" class="ml-2 px-2 text-white bg-red-600 rounded-lg"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M4 6h16M10 11v6m4-6v6M6 6l1 14h10l1-14M9 6V4h6v2" /></svg></button> }
        </div></div>
        <div><label for="insumoUnidad" class="block mb-2 text-sm font-medium dark:text-white">Unidad <span class="text-red-600">*</span></label><select id="insumoUnidad" name="UnidadMedida" required class="bg-gray-50 border border-gray-300 rounded-lg w-full p-2.5 dark:bg-gray-700 dark:text-white"><option value="">Seleccionar unidad</option></select></div>
        <div><label for="insumoMinimo" class="block mb-2 text-sm font-medium dark:text-white">Stock mínimo</label><input id="insumoMinimo" name="StockMinimo" type="number" min="0" step="0.01" placeholder="Ej: 5" class="bg-gray-50 border border-gray-300 rounded-lg w-full p-2.5 dark:bg-gray-700 dark:text-white" /></div>
        <div><label for="insumoReposicion" class="block mb-2 text-sm font-medium dark:text-white">Cantidad de reposición</label><input id="insumoReposicion" name="CantidadReabastecimiento" aria-describedby="reposicion-ayuda" type="number" min="0" step="0.01" placeholder="Ej: 20" class="bg-gray-50 border border-gray-300 rounded-lg w-full p-2.5 dark:bg-gray-700 dark:text-white" /><p id="reposicion-ayuda" class="mt-1 text-xs text-gray-500 dark:text-gray-400">Es la cantidad que se solicita en cada reabastecimiento automático, en la unidad del insumo; no es un objetivo de stock.</p></div>
        <label class="inline-flex items-center cursor-pointer dark:text-white"><input name="ReabastecimientoAutomatico" type="checkbox" value="true" class="sr-only peer" /><span class="relative w-11 h-6 bg-gray-200 rounded-full peer peer-focus:ring-4 peer-focus:ring-blue-300 dark:bg-gray-700 peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></span><span class="ml-3 text-sm font-medium">Reabastecimiento automático</span></label>
        <fieldset class="sm:col-span-2"><legend class="block mb-2 text-sm font-medium dark:text-white">Proveedores (obligatorio si el reabastecimiento automático está activo)</legend><div id="insumo-proveedores" class="bg-gray-50 border border-gray-300 rounded-lg p-3 dark:bg-gray-700"><div class="flex gap-2"><div class="relative flex-1"><label for="insumo-proveedor-search" class="sr-only">Buscar proveedor</label><input id="insumo-proveedor-search" autocomplete="off" placeholder="Buscar proveedor por nombre..." aria-controls="insumo-proveedor-dropdown" aria-expanded="false" class="bg-white border border-gray-300 text-sm rounded-lg w-full p-2.5 dark:bg-gray-600 dark:text-white" /><div id="insumo-proveedor-dropdown" class="hidden absolute z-10 w-full mt-1 bg-white dark:bg-gray-700 border rounded-lg shadow-lg max-h-60 overflow-y-auto">@foreach (var proveedor in proveedores) { <button type="button" data-provider-option data-id="@proveedor.Id" data-name="@proveedor.RazonSocial" class="block w-full text-left px-3 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:text-white">@proveedor.RazonSocial</button> }</div></div><button type="button" data-add-provider class="text-white bg-blue-600 hover:bg-blue-700 rounded-lg px-4 py-2">+ Agregar</button></div><p data-provider-message class="mt-1 text-xs text-gray-500" aria-live="polite">Seleccione un proveedor del listado.</p><div id="insumo-proveedor-selected" class="space-y-2 mt-2"></div><div id="hiddenProveedoresIds"></div>@if (proveedores.Count == 0) { <p>No hay proveedores activos disponibles.</p> }</div></fieldset>
    </div>
    <div class="flex justify-end gap-2 mt-4"><button type="submit" class="app-button app-button--success"><svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-8" aria-hidden="true"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" /></svg>Guardar</button><button type="button" data-reset-insumo class="app-button app-button--danger"><svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-8" aria-hidden="true"><path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm-1.72 6.97a.75.75 0 1 0-1.06 1.06L10.94 12l-1.72 1.72a.75.75 0 1 0 1.06 1.06L12 13.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L13.06 12l1.72-1.72a.75.75 0 1 0-1.06-1.06L12 10.94l-1.72-1.72Z" clip-rule="evenodd" /></svg><span data-reset-label>Limpiar campos</span></button></div>
</form>
