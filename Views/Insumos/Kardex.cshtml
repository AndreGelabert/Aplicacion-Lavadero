@model List<Firebase.Models.MovimientoStock>
@{
    ViewData["Title"] = "Kardex";
    var insumos = (ViewBag.Insumos as List<Firebase.Models.Insumo>) ?? new List<Firebase.Models.Insumo>();
    var insumoMap = insumos.Where(i => !string.IsNullOrEmpty(i.Id)).ToDictionary(i => i.Id, i => i.Nombre);
}
<section class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow">
    <div class="flex justify-between mb-4"><h1 class="text-2xl font-semibold dark:text-white">Kardex</h1><a asp-action="Index" class="app-button app-button--secondary"><svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>Volver</a></div>
    <div class="flex flex-col md:flex-row items-center justify-between gap-3 p-4 relative">
        <label class="w-full md:w-1/2 text-sm text-gray-700 dark:text-gray-300">Buscar movimientos en esta página <input type="search" id="kardex-search" autocomplete="off" placeholder="Buscar en los movimientos mostrados..." class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2 dark:bg-gray-700 dark:text-white" /></label>
        <button type="button" data-dropdown-toggle="kardex-filters" class="py-2 px-4 text-sm font-medium bg-white rounded-lg border border-gray-200 dark:bg-gray-800 dark:text-white">Filtros</button>
    <div id="kardex-filters" class="z-50 hidden bg-white rounded-lg shadow-lg border border-gray-200 dark:bg-gray-700 dark:border-gray-600">
    <form method="get" asp-action="Kardex" class="p-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <fieldset class="dark:text-white"><legend class="mb-3 border-b pb-2">Insumo (seleccione uno)</legend><div class="max-h-40 overflow-y-auto">@foreach (var insumo in insumos) { <label class="flex items-center gap-2"><input type="checkbox" name="insumoId" value="@insumo.Id" checked="@(insumo.Id == (string?)ViewBag.InsumoId)" onchange="if(this.checked) this.form.querySelectorAll('input[name=insumoId]').forEach(x => { if(x !== this) x.checked = false; })" /> @insumo.Nombre</label> }</div></fieldset>
        <fieldset class="dark:text-white"><legend class="mb-3 border-b pb-2">Tipo de movimiento (seleccione uno)</legend><div class="max-h-40 overflow-y-auto">@foreach (var tipo in Enum.GetValues<Firebase.Models.TipoMovimientoStock>()) { <label class="flex items-center gap-2"><input type="checkbox" name="tipo" value="@tipo" checked="@(tipo.ToString() == (string?)ViewBag.Tipo)" onchange="if(this.checked) this.form.querySelectorAll('input[name=tipo]').forEach(x => { if(x !== this) x.checked = false; })" /> @tipo</label> }</div></fieldset>
        <div class="space-y-2 dark:text-white"><h6 class="mb-3 border-b pb-2">Rango de fechas</h6><label>Desde <input type="date" name="desde" value="@(((DateTime?)ViewBag.Desde)?.ToString("yyyy-MM-dd"))" /></label>
        <label>Hasta <input type="date" name="hasta" value="@(((DateTime?)ViewBag.Hasta)?.ToString("yyyy-MM-dd"))" /></label>
        <label>Orden por fecha <select name="sortOrder"><option value="desc" selected="@(ViewBag.SortOrder == "desc")">Más recientes primero</option><option value="asc" selected="@(ViewBag.SortOrder == "asc")">Más antiguos primero</option></select></label>
        </div></div>
        <div class="flex justify-between items-center mt-6 pt-4 border-t border-gray-200 dark:border-gray-600"><a asp-action="Kardex" class="px-4 py-2 text-sm text-gray-600 dark:text-gray-300">Limpiar filtros</a><button type="submit" class="px-6 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Aplicar Filtros</button></div>
    </form></div></div>
    @if (Model.Count == 0) { <p>No hay movimientos para los filtros seleccionados.</p> }
    <div class="overflow-x-auto"><table class="w-full text-sm text-left text-gray-500 dark:text-gray-400"><thead class="text-xs uppercase bg-gray-50 dark:bg-gray-700"><tr class="border-b"><th class="text-left p-2">Fecha</th><th>Insumo</th><th>Tipo</th><th>Cantidad</th><th>Saldo</th><th>Justificación</th></tr></thead><tbody>@foreach (var m in Model) { <tr data-kardex-row class="border-b"><td class="p-2">@m.Fecha.ToLocalTime().ToString("g")</td><td>@(insumoMap.TryGetValue(m.InsumoId, out var nombre) && !string.IsNullOrWhiteSpace(nombre) ? $"{nombre} ({m.InsumoId})" : m.InsumoId)</td><td>@m.Tipo</td><td>@m.Cantidad</td><td>@m.SaldoResultante</td><td>@m.Justificacion</td></tr> }</tbody></table></div>
    <nav aria-label="Paginación de Kardex" class="flex flex-col md:flex-row justify-between items-center gap-3 p-4">
        @if (ViewBag.HasPrevious == true && !string.IsNullOrEmpty((string?)ViewBag.PrevCursor))
        {
            <a asp-action="Kardex"
               asp-route-insumoId="@ViewBag.InsumoId"
               asp-route-tipo="@ViewBag.Tipo"
               asp-route-desde="@(((DateTime?)ViewBag.Desde)?.ToString("yyyy-MM-dd"))"
               asp-route-hasta="@(((DateTime?)ViewBag.Hasta)?.ToString("yyyy-MM-dd"))"
               asp-route-sortOrder="@ViewBag.SortOrder"
               asp-route-cursor="@ViewBag.PrevCursor"
               class="py-2 px-3 bg-white border border-gray-300 rounded-l-lg dark:bg-gray-800 dark:text-white" aria-label="Anterior">&lt;</a>
        }
        else
        {
            <span class="py-2 px-3 border border-gray-300 text-gray-400 rounded-l-lg" aria-disabled="true">&lt;</span>
        }

        <span class="text-gray-600 dark:text-gray-300">Resultados por cursores</span>

        @if (ViewBag.HasNext == true && !string.IsNullOrEmpty((string?)ViewBag.NextCursor))
        {
            <a asp-action="Kardex"
               asp-route-insumoId="@ViewBag.InsumoId"
               asp-route-tipo="@ViewBag.Tipo"
               asp-route-desde="@(((DateTime?)ViewBag.Desde)?.ToString("yyyy-MM-dd"))"
               asp-route-hasta="@(((DateTime?)ViewBag.Hasta)?.ToString("yyyy-MM-dd"))"
               asp-route-sortOrder="@ViewBag.SortOrder"
               asp-route-cursor="@ViewBag.NextCursor"
               class="py-2 px-3 bg-white border border-gray-300 rounded-r-lg dark:bg-gray-800 dark:text-white" aria-label="Siguiente">&gt;</a>
        }
        else
        {
            <span class="py-2 px-3 border border-gray-300 text-gray-400 rounded-r-lg" aria-disabled="true">&gt;</span>
        }
    </nav>
</section>
<script src="~/js/insumos-secondary.js" asp-append-version="true"></script>
