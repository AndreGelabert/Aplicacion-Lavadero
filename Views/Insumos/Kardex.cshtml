@model List<Firebase.Models.MovimientoStock>
@{
    ViewData["Title"] = "Kardex";
    var insumos = (ViewBag.Insumos as List<Firebase.Models.Insumo>) ?? new List<Firebase.Models.Insumo>();
    var insumoMap = insumos.Where(i => !string.IsNullOrEmpty(i.Id)).ToDictionary(i => i.Id, i => i.Nombre);
}
<section class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow">
    <div class="flex justify-between mb-4"><h1 class="text-2xl font-semibold dark:text-white">Kardex</h1><a asp-action="Index" class="app-button app-button--secondary"><svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>Volver</a></div>
    <form method="get" asp-action="Kardex" class="flex flex-wrap gap-3 mb-4">
        <fieldset class="rounded-lg border p-2 dark:text-white"><legend>Insumo (seleccione uno)</legend><div class="max-h-40 overflow-y-auto">@foreach (var insumo in insumos) { <label class="flex items-center gap-2"><input type="checkbox" name="insumoId" value="@insumo.Id" checked="@(insumo.Id == (string?)ViewBag.InsumoId)" onchange="if(this.checked) this.form.querySelectorAll('input[name=insumoId]').forEach(x => { if(x !== this) x.checked = false; })" /> @insumo.Nombre</label> }</div></fieldset>
        <fieldset class="rounded-lg border p-2 dark:text-white"><legend>Tipo (seleccione uno)</legend><div class="max-h-40 overflow-y-auto">@foreach (var tipo in Enum.GetValues<Firebase.Models.TipoMovimientoStock>()) { <label class="flex items-center gap-2"><input type="checkbox" name="tipo" value="@tipo" checked="@(tipo.ToString() == (string?)ViewBag.Tipo)" onchange="if(this.checked) this.form.querySelectorAll('input[name=tipo]').forEach(x => { if(x !== this) x.checked = false; })" /> @tipo</label> }</div></fieldset>
        <label>Desde <input type="date" name="desde" value="@(((DateTime?)ViewBag.Desde)?.ToString("yyyy-MM-dd"))" /></label>
        <label>Hasta <input type="date" name="hasta" value="@(((DateTime?)ViewBag.Hasta)?.ToString("yyyy-MM-dd"))" /></label>
        <label>Orden por fecha <select name="sortOrder"><option value="desc" selected="@(ViewBag.SortOrder == "desc")">Más recientes primero</option><option value="asc" selected="@(ViewBag.SortOrder == "asc")">Más antiguos primero</option></select></label>
        <button type="submit" class="app-button app-button--primary"><svg aria-hidden="true" class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4h18l-7 8v6l-4 2v-8L3 4z" /></svg>Filtrar</button><a asp-action="Kardex" class="app-button app-button--secondary"><svg aria-hidden="true" class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" /></svg>Limpiar</a>
    </form>
    @if (Model.Count == 0) { <p>No hay movimientos para los filtros seleccionados.</p> }
    <div class="overflow-x-auto"><table class="w-full text-sm text-left text-gray-500 dark:text-gray-400"><thead class="text-xs uppercase bg-gray-50 dark:bg-gray-700"><tr class="border-b"><th class="text-left p-2">Fecha</th><th>Insumo</th><th>Tipo</th><th>Cantidad</th><th>Saldo</th><th>Justificación</th></tr></thead><tbody>@foreach (var m in Model) { <tr class="border-b"><td class="p-2">@m.Fecha.ToLocalTime().ToString("g")</td><td>@(insumoMap.TryGetValue(m.InsumoId, out var nombre) && !string.IsNullOrWhiteSpace(nombre) ? $"{nombre} ({m.InsumoId})" : m.InsumoId)</td><td>@m.Tipo</td><td>@m.Cantidad</td><td>@m.SaldoResultante</td><td>@m.Justificacion</td></tr> }</tbody></table></div>
    <nav aria-label="Paginación de Kardex" class="flex items-center gap-3 mt-4">
        @if (ViewBag.HasPrevious == true && !string.IsNullOrEmpty((string?)ViewBag.PrevCursor))
        {
            <a asp-action="Kardex"
               asp-route-insumoId="@ViewBag.InsumoId"
               asp-route-tipo="@ViewBag.Tipo"
               asp-route-desde="@(((DateTime?)ViewBag.Desde)?.ToString("yyyy-MM-dd"))"
               asp-route-hasta="@(((DateTime?)ViewBag.Hasta)?.ToString("yyyy-MM-dd"))"
               asp-route-sortOrder="@ViewBag.SortOrder"
               asp-route-cursor="@ViewBag.PrevCursor"
               class="text-blue-600 hover:underline">Anterior</a>
        }
        else
        {
            <span class="text-gray-400">Anterior</span>
        }

        <span class="text-gray-600 dark:text-gray-300">Navegación por cursores</span>

        @if (ViewBag.HasNext == true && !string.IsNullOrEmpty((string?)ViewBag.NextCursor))
        {
            <a asp-action="Kardex"
               asp-route-insumoId="@ViewBag.InsumoId"
               asp-route-tipo="@ViewBag.Tipo"
               asp-route-desde="@(((DateTime?)ViewBag.Desde)?.ToString("yyyy-MM-dd"))"
               asp-route-hasta="@(((DateTime?)ViewBag.Hasta)?.ToString("yyyy-MM-dd"))"
               asp-route-sortOrder="@ViewBag.SortOrder"
               asp-route-cursor="@ViewBag.NextCursor"
               class="text-blue-600 hover:underline">Siguiente</a>
        }
        else
        {
            <span class="text-gray-400">Siguiente</span>
        }
    </nav>
</section>
