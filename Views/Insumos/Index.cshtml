@model List<Firebase.Models.Insumo>
@{
    ViewData["Title"] = "Insumos y Stock";
    var porcentajeAlerta = (decimal)ViewBag.PorcentajeAlertaStock;
    var filtrosTipos = (string[]?)ViewBag.FiltrosTipos ?? Array.Empty<string>();
    var tiposFiltro = ((ViewBag.Tipos as List<Firebase.Models.TipoInsumo>) ?? new()).Select(t => t.Nombre).ToList();
    if (tiposFiltro.Count == 0) tiposFiltro.AddRange(new[] { "Quimico", "Fisico", "Herramienta" });
    foreach (var filtro in filtrosTipos) if (!tiposFiltro.Contains(filtro, StringComparer.OrdinalIgnoreCase)) tiposFiltro.Add(filtro);
}
<section class="bg-gray-50 dark:bg-gray-900">
    <div class="mx-auto bg-white dark:bg-gray-800 shadow-md sm:rounded-lg p-4">
        @if ((int?)ViewBag.Criticos > 0)
        {
            <div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-red-800 dark:border-red-800 dark:bg-red-900/30 dark:text-red-200">
                Hay <strong>@ViewBag.Criticos</strong> insumo(s) activo(s) en stock crítico.
                <a asp-route-soloBajoMinimo="true" class="ml-2 underline">Ver críticos</a>
            </div>
        }
        @foreach (var alerta in (ViewBag.AlertasStock as List<string>) ?? new List<string>())
        {
            <div class="mb-2 rounded-lg border border-yellow-200 bg-yellow-50 p-3 text-yellow-800 dark:border-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-200">@alerta</div>
        }
        <div class="flex flex-wrap justify-between items-center gap-2 mb-4">
            <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Insumos y Stock</h1>
            <div class="flex flex-wrap gap-2 min-w-0">
                <a asp-action="Kardex" class="app-button app-button--secondary"><svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M4 4h16v16H4z M8 8h8M8 12h8M8 16h5" /></svg> Kardex</a>
                <a asp-action="Proveedores" class="app-button app-button--secondary"><svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M3 5h12v11H3z M15 9h3l3 3v4h-6z M6 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M18 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" /></svg> Proveedores</a>
                <a asp-action="Ordenes" class="app-button app-button--secondary"><svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M5 3h14v18H5z M8 8h8M8 12h8M8 16h5" /></svg> Órdenes</a>
                @if (User.TienePermiso("Insumos.Modificar")) { <a asp-action="Cotizaciones" class="app-button app-button--secondary"><svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M5 3h10l4 4v14H5z M14 3v5h5M8 12h8M8 16h6" /></svg> Cotizaciones</a> }
            </div>
        </div>
        <form method="get" class="flex flex-col md:flex-row items-stretch md:items-center gap-3 mb-4">
            <div class="relative w-full md:w-96">
                <label for="insumos-search" class="sr-only">Buscar insumo</label>
                <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none"><svg aria-hidden="true" class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" /></svg></div>
                <input id="insumos-search" name="search" value="@Context.Request.Query["search"]" placeholder="Buscar insumo" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full pl-10 p-2 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" />
            </div>
            <details data-insumos-filters class="relative">
                <summary class="cursor-pointer list-none flex items-center justify-center py-2 px-4 text-sm font-medium text-gray-900 bg-white rounded-lg border border-gray-200 hover:bg-gray-100 focus:ring-4 focus:ring-gray-200 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700"><svg aria-hidden="true" class="h-4 w-4 mr-2 text-gray-400" viewBox="0 0 20 20" fill="currentColor"><path d="M3 3h14v3l-5 5v4l-4 2v-6L3 6z" /></svg> Filtros</summary>
                <div class="absolute z-50 mt-2 w-64 max-w-[80vw] p-4 bg-white rounded-lg shadow-lg border border-gray-200 dark:bg-gray-700 dark:border-gray-600">
                    <fieldset class="text-sm text-gray-900 dark:text-white"><legend class="font-medium mb-2">Tipos</legend>
                        <div class="max-h-40 overflow-y-auto space-y-1">
                        @foreach (var nombre in tiposFiltro)
                        {
                            <label class="flex items-center gap-2"><input type="checkbox" name="tipos" value="@nombre" checked="@filtrosTipos.Contains(nombre, StringComparer.OrdinalIgnoreCase)" /> @nombre</label>
                        }
                        </div>
                    </fieldset>
                    <label class="flex items-center gap-2 mt-3 text-sm text-gray-900 dark:text-white"><input type="checkbox" name="soloBajoMinimo" value="true" checked="@(Context.Request.Query["soloBajoMinimo"] == "true")" /> Solo bajo mínimo</label>
                </div>
            </details>
            <button class="app-button app-button--primary">Filtrar</button>
        </form>
        @if (User.TienePermiso("Insumos.Crear"))
        {
            <button type="button" data-modal-target="crearInsumoModal" data-open-insumo class="app-button app-button--primary mb-5"><svg aria-hidden="true" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor"><path d="M10 3a1 1 0 0 1 1 1v5h5a1 1 0 1 1 0 2h-5v5a1 1 0 1 1-2 0v-5H4a1 1 0 1 1 0-2h5V4a1 1 0 0 1 1-1z" /></svg> Nuevo insumo</button>
            <div id="crearInsumoModal" tabindex="-1" aria-hidden="true" aria-labelledby="crearInsumoTitulo" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 flex justify-center items-center w-full md:inset-0 h-modal md:h-full">
                <div class="relative p-4 w-full max-w-2xl h-full md:h-auto"><div class="relative p-4 bg-white rounded-lg shadow dark:bg-gray-800 sm:p-5">
                    <div class="flex justify-between items-center pb-4 border-b dark:border-gray-600"><h3 id="crearInsumoTitulo" class="text-lg font-semibold dark:text-white">Nuevo insumo</h3><button type="button" data-close-insumo aria-label="Cerrar" class="text-gray-500"><svg aria-hidden="true" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor"><path d="M4.3 5.7 8.6 10l-4.3 4.3 1.4 1.4 4.3-4.3 4.3 4.3 1.4-1.4-4.3-4.3 4.3-4.3-1.4-1.4L10 8.6 5.7 4.3z" /></svg></button></div>
                    <partial name="_InsumoForm" model="new Firebase.Models.Insumo()" />
                </div></div>
            </div>
            <partial name="_TiposInsumoModal" />
        }
        <p class="mb-3 text-sm text-gray-500">El total físico incluye todos los productos del tipo, incluso inactivos y los que no coinciden con los filtros. Se paginan grupos completos; el detalle muestra todos los productos del grupo que coinciden con los filtros. Los productos no son necesariamente intercambiables; las reservas son informativas y pueden cambiar.</p>
        @foreach (var grupo in (ViewBag.Grupos as List<Firebase.Models.InventarioAgrupadoViewModel>) ?? new())
        {
        <details class="mb-3 rounded border" open>
            <summary class="cursor-pointer p-3 font-semibold">@grupo.Nombre — stock físico total: @if (grupo.TotalFisico.HasValue) { <span>@grupo.TotalFisico <span data-unidad="@grupo.UnidadResumen">@grupo.UnidadResumen</span></span> } else { <span>No disponible (tipo o unidades inconsistentes)</span> }</summary>
        <div class="overflow-x-auto">
            <table class="min-w-[800px] w-full text-sm text-left text-gray-500 dark:text-gray-400">
                <thead class="text-xs uppercase bg-gray-50 dark:bg-gray-700"><tr><th class="px-4 py-3">Nombre</th><th>Tipo</th><th>Unidad</th><th>Stock</th><th>Estado</th><th>Acciones</th></tr></thead>
                <tbody>
                @foreach (var producto in grupo.Productos)
                {
                    var item = producto.Insumo;
                    var critico = item.StockActual <= item.StockMinimo;
                    var alerta = false;
                    if (!critico && item.StockMinimo > 0)
                    {
                        try { alerta = item.StockActual <= item.StockMinimo + item.StockMinimo * (porcentajeAlerta / 100); }
                        catch (OverflowException) { alerta = true; }
                    }
                    <tr class="border-b dark:border-gray-700">
                        <td class="px-4 py-3 font-medium text-gray-900 dark:text-white">@item.Nombre</td>
                        <td>@item.Tipo</td><td><span data-unidad="@item.UnidadMedida">@item.UnidadMedida</span></td>
                        <td><span class="@(critico ? "text-red-600 font-bold" : "")">Físico: @item.StockActual</span> / mín. @item.StockMinimo<br />Reservado: @(producto.Reservado?.ToString() ?? "No disponible")<br />Disponible: @(producto.Disponible?.ToString() ?? "No disponible (reserva inconsistente o desconocida)") @if (critico) { <span class="ml-1 rounded bg-red-100 px-2 py-1 text-xs text-red-800">Crítico</span> } else if (alerta) { <span class="ml-1 rounded bg-yellow-100 px-2 py-1 text-xs text-yellow-800">Próximo al mínimo</span> }</td>
                        <td>@item.Estado</td>
                        <td class="flex gap-2 py-2">
                            @if (User.TienePermiso("Insumos.AjustarStock"))
                            {
                                <details><summary class="cursor-pointer inline-flex items-center gap-1 text-blue-600"><svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M12 4v16M4 12h16" /></svg> Ajustar</summary><form method="post" asp-action="Ajustar" class="mt-2 space-y-1">@Html.AntiForgeryToken()<input type="hidden" name="insumoId" value="@item.Id" /><input name="cantidad" type="number" step="0.01" min="0.01" required class="w-24 rounded border p-1" placeholder="Cantidad" /><select name="ingreso" class="rounded border p-1"><option value="true">Ingreso</option><option value="false">Egreso</option></select><input name="justificacion" required class="rounded border p-1" placeholder="Justificación" /><button class="text-green-600">Guardar</button></form></details>
                            }
                            @if (User.TienePermiso("Insumos.Modificar"))
                            {
                                <details><summary class="cursor-pointer inline-flex items-center gap-1 text-blue-600"><svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M4 20h4L19 9l-4-4L4 16z" /></svg> Editar</summary><partial name="_InsumoForm" model="item" /></details>
                                <form method="post" asp-action="CambiarEstado">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="estado" value="@(item.Estado == "Activo" ? "Inactivo" : "Activo")" /><button class="inline-flex items-center gap-1 text-orange-600"><svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M12 3v9M6 6a9 9 0 1 0 12 0" /></svg> @(item.Estado == "Activo" ? "Desactivar" : "Reactivar")</button></form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        </details>
        }
        @if ((int)ViewBag.TotalPages > 1)
        {
            <nav class="mt-4 flex items-center justify-between" aria-label="Paginación de grupos de insumos">
                <span class="text-sm text-gray-500">Página @ViewBag.Page de @ViewBag.TotalPages</span>
                <div class="flex gap-2">
                    @for (var numero = 1; numero <= (int)ViewBag.TotalPages; numero++)
                    {
                        if (numero == (int)ViewBag.Page) { <span class="app-button app-button--primary" aria-current="page">@numero</span> }
                        else {
                            var parametros = Context.Request.Query.Where(q => !string.Equals(q.Key, "page", StringComparison.OrdinalIgnoreCase)).SelectMany(q => q.Value.Select(v => new KeyValuePair<string, string?>(q.Key, v))).ToList();
                            parametros.Add(new KeyValuePair<string, string?>("page", numero.ToString()));
                            <a class="app-button app-button--secondary" href="@Microsoft.AspNetCore.Http.QueryString.Create(parametros)" data-page="@numero">@numero</a>
                        }
                    }
                </div>
            </nav>
        }
    </div>
</section>
<script src="~/js/tipos-insumo.js" asp-append-version="true"></script>
<script src="~/js/insumos.js" asp-append-version="true"></script>
