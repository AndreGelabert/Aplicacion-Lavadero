@model List<Firebase.Models.Insumo>
@{
    ViewData["Title"] = "Insumos y Stock";
    var porcentajeAlerta = (decimal)ViewBag.PorcentajeAlertaStock;
    var filtrosTipos = (string[]?)ViewBag.FiltrosTipos ?? Array.Empty<string>();
    var filtrosEstados = (string[]?)ViewBag.FiltrosEstados ?? new[] { "Activo" };
    var tiposFiltro = ((ViewBag.Tipos as List<Firebase.Models.TipoInsumo>) ?? new()).Select(t => t.Nombre).ToList();
    if (tiposFiltro.Count == 0) tiposFiltro.AddRange(new[] { "Quimico", "Fisico", "Herramienta" });
    foreach (var filtro in filtrosTipos) if (!tiposFiltro.Contains(filtro, StringComparer.OrdinalIgnoreCase)) tiposFiltro.Add(filtro);
}
<section class="bg-gray-50 dark:bg-gray-900">
    <div class="mx-auto bg-white dark:bg-gray-800 relative shadow-md sm:rounded-lg overflow-visible">
        @if ((int?)ViewBag.Criticos > 0)
        {
            <div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-red-800 dark:border-red-800 dark:bg-red-900/30 dark:text-red-200">
                Hay <strong>@ViewBag.Criticos</strong> insumo(s) activo(s) en stock crítico.
                <a asp-route-soloBajoMinimo="true" class="ml-2 underline">Ver críticos</a>
            </div>
        }
        @foreach (var alerta in (ViewBag.AlertasStock as List<string>) ?? new List<string>())
        {
            <div class="mb-2 rounded-lg border border-yellow-200 bg-yellow-50 p-3 text-yellow-800 dark:border-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-200">@alerta</div>
        }
        <div class="p-2 flex justify-between items-center rounded-t border-b dark:border-gray-600">
            <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Insumos y Stock</h1>
            <button type="button" data-popover-target="insumos-ayuda" data-popover-trigger="click" data-popover-placement="bottom" aria-label="Ayuda" class="text-white inline-flex items-center bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-2 py-2 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z"></path></svg></button><div data-popover id="insumos-ayuda" role="tooltip" class="absolute z-10 invisible inline-block w-64 text-sm text-gray-500 transition-opacity duration-300 bg-white border border-gray-200 rounded-lg shadow-xs opacity-0 dark:text-gray-400 dark:border-gray-600 dark:bg-gray-800"><div class="px-3 py-2 bg-gray-100 border-b border-gray-200 rounded-t-lg dark:border-gray-600 dark:bg-gray-700"><h3 class="font-semibold text-gray-900 dark:text-white">Ayuda</h3></div><div class="px-3 py-2"><p>En esta página puedes consultar el stock físico, reservado y disponible de los insumos. Usa la búsqueda y los filtros para localizar productos; según tus permisos, también puedes registrarlos, editarlos o ajustar su stock.</p></div><div data-popper-arrow></div></div>
        </div>
        @if (User.TienePermiso("Insumos.Crear") || User.TienePermiso("Insumos.Modificar")) {
        <div id="accordion-flush" data-accordion="collapse" data-active-classes="bg-white dark:bg-gray-900 text-gray-900 dark:text-white" data-inactive-classes="text-gray-500 dark:text-gray-400"><h2 id="accordion-flush-heading-1"><button type="button" class="flex items-center justify-between w-full p-2 py-5 font-medium text-gray-500 border-b border-gray-200 dark:border-gray-700 gap-3" data-accordion-target="#accordion-flush-body-1" aria-expanded="false" aria-controls="accordion-flush-body-1"><span class="flex items-center gap-2"><span id="form-title">Registrando un Insumo</span><svg data-accordion-icon class="w-3 h-3 rotate-180 shrink-0" fill="none" viewBox="0 0 10 6"><path stroke="currentColor" stroke-width="2" d="M9 5 5 1 1 5" /></svg></span></button></h2><div id="accordion-flush-body-1" class="hidden" aria-labelledby="accordion-flush-heading-1"><partial name="_InsumoForm" model="new Firebase.Models.Insumo()" /></div></div>
        @if (User.TienePermiso("Insumos.Crear")) { <partial name="_TiposInsumoModal" /> }
        }
        <div data-insumos-toolbar class="p-4">
        <form method="get" class="flex flex-wrap items-center gap-3">
            <div class="relative flex-1 min-w-[12rem]">
                <label for="insumos-search" class="sr-only">Buscar insumo</label>
                <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none"><svg aria-hidden="true" class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" /></svg></div>
                <input id="insumos-search" name="search" value="@Context.Request.Query["search"]" placeholder="Buscar insumo" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full pl-10 p-2 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" />
            </div>
            <div class="flex flex-wrap gap-2">
            <a asp-action="Kardex" class="text-white inline-flex items-center bg-purple-600 hover:bg-purple-700 rounded-lg px-3 py-2"><svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M4 4h16v16H4z M8 8h8M8 12h8" /></svg> Kardex</a>
            <a asp-action="Proveedores" class="text-white inline-flex items-center bg-purple-600 hover:bg-purple-700 rounded-lg px-3 py-2"><svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M3 5h12v11H3z M15 9h3l3 3v4h-6z" /></svg> Proveedores</a>
            <a asp-action="Ordenes" class="text-white inline-flex items-center bg-purple-600 hover:bg-purple-700 rounded-lg px-3 py-2"><svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M5 3h14v18H5z M8 8h8" /></svg> Órdenes</a>
            @if (User.TienePermiso("Insumos.Modificar")) { <a asp-action="Cotizaciones" class="text-white inline-flex items-center bg-purple-600 hover:bg-purple-700 rounded-lg px-3 py-2"><svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M5 3h10l4 4v14H5z" /></svg> Cotizaciones</a> }
            </div>
            <div class="relative">
                <button type="button" data-dropdown-toggle="insumosFiltros" class="w-full md:w-auto flex items-center justify-center py-2 px-4 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-primary-700 focus:z-10 focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700"><svg aria-hidden="true" class="h-4 w-4 mr-2 text-gray-400" viewBox="0 0 20 20" fill="currentColor"><path d="M3 3h14v3l-5 5v4l-4 2v-6L3 6z" /></svg> Filtros <svg aria-hidden="true" class="ml-1.5 w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 011.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg></button>
                <div id="insumosFiltros" class="hidden absolute z-50 mt-2 w-64 max-w-[80vw] p-4 bg-white rounded-lg shadow-lg border border-gray-200 dark:bg-gray-700 dark:border-gray-600">
                    <fieldset class="text-sm text-gray-900 dark:text-white"><legend class="font-medium mb-2">Tipos</legend>
                        <div class="max-h-40 overflow-y-auto space-y-1">
                        @foreach (var nombre in tiposFiltro)
                        {
                            <label class="flex items-center gap-2"><input type="checkbox" name="tipos" value="@nombre" checked="@filtrosTipos.Contains(nombre, StringComparer.OrdinalIgnoreCase)" class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500" /> @nombre</label>
                        }
                        </div>
                    </fieldset>
                    <fieldset class="mt-3 text-sm text-gray-900 dark:text-white"><legend class="font-medium mb-2">Estado</legend>
                        <input type="hidden" name="estados" value="" />
                        @foreach (var estado in new[] { "Activo", "Inactivo" }) {
                            <label class="flex items-center gap-2"><input type="checkbox" name="estados" value="@estado" checked="@filtrosEstados.Contains(estado, StringComparer.OrdinalIgnoreCase)" class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500" /> @(estado == "Activo" ? "Activos" : "Inactivos")</label>
                        }
                    </fieldset>
                    <label class="flex items-center gap-2 mt-3 text-sm text-gray-900 dark:text-white"><input type="checkbox" name="soloBajoMinimo" value="true" checked="@(Context.Request.Query["soloBajoMinimo"] == "true")" class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500" /> Solo bajo mínimo</label>
                    <div class="flex justify-between items-center mt-6 pt-4 border-t border-gray-200 dark:border-gray-600"><button type="button" data-clear-insumos-filters class="text-sm text-gray-600 hover:text-gray-800 dark:text-gray-400">Limpiar filtros</button><button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Aplicar Filtros</button></div>
                </div>
            </div>
        </form></div>
        <p class="mb-3 text-sm text-gray-500">El total físico incluye todos los productos del tipo, incluso inactivos y los que no coinciden con los filtros. Se paginan grupos completos; el detalle muestra todos los productos del grupo que coinciden con los filtros. Los productos no son necesariamente intercambiables; las reservas son informativas y pueden cambiar.</p>
        @foreach (var grupo in (ViewBag.Grupos as List<Firebase.Models.InventarioAgrupadoViewModel>) ?? new())
        {
        <section class="mb-3 rounded border">
            <h2 class="p-3 font-semibold">@grupo.Nombre — stock físico total: @if (grupo.TotalFisico.HasValue) { <span>@grupo.TotalFisico <span data-unidad="@grupo.UnidadResumen">@grupo.UnidadResumen</span></span> } else { <span>No disponible (tipo o unidades inconsistentes)</span> }</h2>
        <div class="overflow-x-auto">
            <table class="min-w-[800px] w-full text-sm text-left text-gray-500 dark:text-gray-400">
                <thead class="text-xs uppercase bg-gray-50 dark:bg-gray-700"><tr><th class="px-4 py-3"><button type="button" data-sort-insumos="nombre" aria-label="Ordenar productos dentro de este grupo por nombre">Nombre ⇅</button></th><th>Tipo</th><th>Unidad</th><th>Stock</th><th>Estado</th><th>Acciones</th></tr></thead>
                <tbody>
                @foreach (var producto in grupo.Productos)
                {
                    var item = producto.Insumo;
                    var critico = item.StockActual <= item.StockMinimo;
                    var alerta = false;
                    if (!critico && item.StockMinimo > 0)
                    {
                        try { alerta = item.StockActual <= item.StockMinimo + item.StockMinimo * (porcentajeAlerta / 100); }
                        catch (OverflowException) { alerta = true; }
                    }
                    <tr class="border-b dark:border-gray-700">
                        <td class="px-4 py-3 font-medium text-gray-900 dark:text-white">@item.Nombre</td>
                        <td>@item.Tipo</td><td><span data-unidad="@item.UnidadMedida">@item.UnidadMedida</span></td>
                        <td><span class="@(critico ? "text-red-600 font-bold" : "")">Físico: @item.StockActual</span> / mín. @item.StockMinimo<br />Reservado: @(producto.Reservado?.ToString() ?? "No disponible")<br />Disponible: @(producto.Disponible?.ToString() ?? "No disponible (reserva inconsistente o desconocida)") @if (critico) { <span class="ml-1 rounded bg-red-100 px-2 py-1 text-xs text-red-800">Crítico</span> } else if (alerta) { <span class="ml-1 rounded bg-yellow-100 px-2 py-1 text-xs text-yellow-800">Próximo al mínimo</span> }</td>
                        <td><span class="rounded px-2.5 py-0.5 text-xs font-medium @(item.Estado == "Activo" ? "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300" : "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300")">@item.Estado</span></td>
                        <td class="flex gap-2 py-2">
                            @if (User.TienePermiso("Insumos.AjustarStock"))
                            {
                                <button type="button" data-ajustar-insumo data-id="@item.Id" data-nombre="@item.Nombre" data-unidad-ajuste="@item.UnidadMedida" aria-label="Ajustar stock" class="p-1.5 text-white bg-purple-600 rounded-lg hover:bg-purple-700 transition-colors"><svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M12 4v16M4 12h16" /></svg></button>
                            }
                            @if (User.TienePermiso("Insumos.Modificar"))
                            {
                                <button type="button" data-edit-insumo data-record="@System.Text.Json.JsonSerializer.Serialize(item)" aria-label="Editar" class="p-1.5 text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-colors"><svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.687a2.25 2.25 0 0 1 3.182 3.182L10.5 17.213l-4.5 1.5 1.5-4.5L16.862 4.487z" /></svg></button>
                                <button type="button" data-estado-insumo data-id="@item.Id" data-nombre="@item.Nombre" data-estado="@(item.Estado == "Activo" ? "Inactivo" : "Activo")" aria-label="@(item.Estado == "Activo" ? "Desactivar" : "Reactivar")" class="p-1.5 text-white @(item.Estado == "Activo" ? "bg-red-600 hover:bg-red-700" : "bg-green-600 hover:bg-green-700") rounded-lg transition-colors">@if (item.Estado == "Activo") { <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg> } else { <svg aria-hidden="true" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" /></svg> }</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        </section>
        }
        <div id="insumoAjusteModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50" role="dialog" aria-modal="true" aria-labelledby="insumoAjusteTitulo"><div class="w-full max-w-md m-4 p-5 bg-white dark:bg-gray-800 rounded-lg"><h3 id="insumoAjusteTitulo" class="text-lg font-semibold dark:text-white border-b pb-4">Ajustar stock</h3><form method="post" asp-action="Ajustar" class="space-y-3 mt-4">@Html.AntiForgeryToken()<input type="hidden" name="insumoId" /><label class="block text-sm font-medium dark:text-white">Cantidad <span class="text-red-600">*</span><input name="cantidad" type="number" step="0.01" min="0.01" placeholder="Ej: 2 o -1" required aria-describedby="ajuste-unidad" class="mt-2 block w-full bg-gray-50 border border-gray-300 rounded-lg p-2.5 dark:bg-gray-700 dark:text-white" /><span id="ajuste-unidad" data-ajuste-unidad class="text-xs text-gray-500">Ingrese una cantidad mayor que cero.</span></label><label class="block text-sm font-medium dark:text-white">Movimiento <span class="text-red-600">*</span><select name="ingreso" required class="mt-2 block w-full bg-gray-50 border border-gray-300 rounded-lg p-2.5 dark:bg-gray-700 dark:text-white"><option value="true">Ingreso</option><option value="false">Egreso</option></select></label><label class="block text-sm font-medium dark:text-white">Justificación <span class="text-red-600">*</span><input name="justificacion" placeholder="Motivo del ajuste físico o merma" required class="mt-2 block w-full bg-gray-50 border border-gray-300 rounded-lg p-2.5 dark:bg-gray-700 dark:text-white" /><span class="text-xs text-gray-500">Indique el motivo del ajuste.</span></label><div class="flex justify-end gap-2"><button type="submit" class="app-button app-button--success"><svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-8" aria-hidden="true"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" /></svg>Guardar</button><button type="button" data-close-dialog class="app-button app-button--danger"><svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-8" aria-hidden="true"><path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm-1.72 6.97a.75.75 0 1 0-1.06 1.06L10.94 12l-1.72 1.72a.75.75 0 1 0 1.06 1.06L12 13.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L13.06 12l1.72-1.72a.75.75 0 1 0-1.06-1.06L12 10.94l-1.72-1.72Z" clip-rule="evenodd" /></svg>Cancelar</button></div></form></div></div>
        <div id="insumoConfirmModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50" role="dialog" aria-modal="true"><div class="w-full max-w-md m-4 p-5 bg-white dark:bg-gray-800 rounded-lg text-center"><div id="insumoConfirmIconWrapper" class="w-12 h-12 rounded-full bg-red-100 dark:bg-red-900 p-2 flex items-center justify-center mx-auto mb-3.5"><svg id="insumoConfirmIcon" class="w-8 h-8 text-red-600 dark:text-red-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"></svg></div><h3 id="insumoConfirmTitle" class="text-lg font-semibold">Desactivar Insumo</h3><p id="insumoConfirmMessage" class="my-4"></p><form method="post" asp-action="CambiarEstado">@Html.AntiForgeryToken()<input type="hidden" name="id" /><input type="hidden" name="estado" /><button type="button" data-close-dialog class="app-button app-button--secondary">Cancelar</button> <button type="submit" class="app-button app-button--danger" id="insumoConfirmSubmit">Desactivar</button></form></div></div>
        @if ((int)ViewBag.TotalPages > 1)
        {
            var parametrosBase = Context.Request.Query.Where(q => !string.Equals(q.Key, "page", StringComparison.OrdinalIgnoreCase)).SelectMany(q => q.Value.Select(v => new KeyValuePair<string, string?>(q.Key, v))).ToList();
            string UrlPagina(int pagina) => Microsoft.AspNetCore.Http.QueryString.Create(parametrosBase.Append(new KeyValuePair<string, string?>("page", pagina.ToString()))).ToString();
            var flechaClase = "flex items-center justify-center h-full py-1.5 px-3 bg-white border border-gray-300 dark:bg-gray-800 dark:border-gray-700";
            var habilitadoClase = "text-gray-500 hover:bg-gray-100 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white";
            var deshabilitadoClase = "text-gray-300 cursor-not-allowed";
            <nav class="flex flex-col md:flex-row justify-between items-start md:items-center space-y-3 md:space-y-0 p-4" aria-label="Paginación de grupos de insumos">
                <span class="text-sm font-normal text-gray-500 dark:text-gray-400">Mostrando página <span class="font-semibold text-gray-900 dark:text-white">@ViewBag.Page</span> de <span class="font-semibold text-gray-900 dark:text-white">@ViewBag.TotalPages</span></span>
                <div class="inline-flex items-stretch -space-x-px">
                    @if ((int)ViewBag.Page > 1) { <a aria-label="Página anterior" data-page="@((int)ViewBag.Page - 1)" href="@UrlPagina((int)ViewBag.Page - 1)" class="@flechaClase @habilitadoClase rounded-l-lg"><svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" /></svg></a> } else { <span aria-label="Página anterior" aria-disabled="true" class="@flechaClase @deshabilitadoClase rounded-l-lg"><svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" /></svg></span> }
                    @for (var numero = 1; numero <= (int)ViewBag.TotalPages; numero++)
                    {
                        if (numero == (int)ViewBag.Page) { <span class="flex items-center justify-center text-sm z-10 py-2 px-3 leading-tight text-primary-600 bg-primary-50 border border-primary-300 dark:border-gray-700 dark:bg-gray-700 dark:text-white" aria-current="page">@numero</span> }
                        else { <a class="flex items-center justify-center text-sm py-2 px-3 leading-tight text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white" href="@UrlPagina(numero)" data-page="@numero">@numero</a> }
                    }
                    @if ((int)ViewBag.Page < (int)ViewBag.TotalPages) { <a aria-label="Página siguiente" data-page="@((int)ViewBag.Page + 1)" href="@UrlPagina((int)ViewBag.Page + 1)" class="@flechaClase @habilitadoClase rounded-r-lg"><svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" /></svg></a> } else { <span aria-label="Página siguiente" aria-disabled="true" class="@flechaClase @deshabilitadoClase rounded-r-lg"><svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" /></svg></span> }
                </div>
            </nav>
        }
    </div>
</section>
