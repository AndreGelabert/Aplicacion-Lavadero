@using Firebase.Security
<div id="tiposInsumoModal" tabindex="-1" aria-hidden="true" aria-labelledby="tiposInsumoTitulo" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 flex justify-center items-center w-full md:inset-0 h-modal md:h-full"
     data-list-url="@Url.Action("ModalDatos", "TiposInsumo")" data-save-url="@Url.Action("ModalGuardar", "TiposInsumo")" data-state-url="@Url.Action("ModalEstado", "TiposInsumo")" data-tool-url="@Url.Action("ModalInicializarHerramienta", "TiposInsumo")" data-can-edit="@User.TienePermiso("Insumos.Modificar").ToString().ToLowerInvariant()">
    <div class="relative p-4 w-full max-w-2xl"><div class="relative p-4 bg-white rounded-lg shadow dark:bg-gray-800 sm:p-5" style="max-height: calc(100vh - 2rem); overflow-y: auto;">
        <div class="flex justify-between items-center pb-4 mb-4 border-b dark:border-gray-600">
            <h3 id="tiposInsumoTitulo" class="text-lg font-semibold text-gray-900 dark:text-white">Tipos de insumo</h3>
            <button type="button" data-close-tipos class="text-gray-500" aria-label="Cerrar tipos de insumo"><svg aria-hidden="true" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor"><path d="M4.3 5.7 8.6 10l-4.3 4.3 1.4 1.4 4.3-4.3 4.3 4.3 1.4-1.4-4.3-4.3 4.3-4.3-1.4-1.4L10 8.6 5.7 4.3z" /></svg></button>
        </div>
        <p id="tiposInsumoMensaje" role="status" aria-live="polite" class="mb-3 text-sm dark:text-white"></p>
        <form id="tipoInsumoForm" method="post" class="grid sm:grid-cols-2 gap-3 mb-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="crear" value="true" /><input type="hidden" name="Id" />
            <label class="block text-sm font-medium dark:text-white">Nombre <span class="text-red-600">*</span><input name="Nombre" placeholder="Ej: Ceras y Selladores" required maxlength="120" class="mt-2 block w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg p-2.5 dark:bg-gray-700 dark:text-white" /><span class="text-xs text-gray-500">Máximo 120 caracteres.</span></label>
            <label class="block text-sm font-medium dark:text-white">Categoría <span class="text-red-600">*</span><select name="Categoria" required class="mt-2 block w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg p-2.5 dark:bg-gray-700 dark:text-white"><option value="Volumen">Volumen</option><option value="Masa">Masa</option><option value="Unidades">Unidades</option></select></label>
            <label class="block text-sm font-medium dark:text-white">Unidad resumen <span class="text-red-600">*</span><select name="UnidadResumen" required class="mt-2 block w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg p-2.5 dark:bg-gray-700 dark:text-white"><option value="ml">Mililitro (mL)</option><option value="l">Litro (L)</option><option value="mg">Miligramo (mg)</option><option value="g">Gramo (g)</option><option value="kg">Kilogramo (kg)</option><option value="unidad">Unidad (u)</option></select></label>
            <div class="flex justify-end items-end gap-2 sm:col-span-2"><button class="app-button app-button--success" type="submit"><svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-8" aria-hidden="true"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" /></svg>Guardar tipo</button><button class="app-button app-button--danger" type="button" data-reset-tipo><svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-8" aria-hidden="true"><path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm-1.72 6.97a.75.75 0 1 0-1.06 1.06L10.94 12l-1.72 1.72a.75.75 0 1 0 1.06 1.06L12 13.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L13.06 12l1.72-1.72a.75.75 0 1 0-1.06-1.06L12 10.94l-1.72-1.72Z" clip-rule="evenodd" /></svg>Cancelar</button></div>
        </form>
        <button type="button" data-init-tool class="app-button app-button--secondary mb-3">Inicializar Herramienta</button>
        <div class="overflow-x-auto"><table class="w-full text-sm text-left dark:text-gray-200"><thead class="bg-gray-50 dark:bg-gray-700"><tr><th>Nombre</th><th>Categoría</th><th>Unidad resumen</th><th>Estado</th><th>Acciones</th></tr></thead><tbody id="tiposInsumoTabla"></tbody></table></div>
    </div></div>
</div>
<div id="confirmarEliminarTipoInsumo" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50" role="dialog" aria-modal="true" aria-labelledby="confirmarEliminarTipoTitulo"><div class="w-full max-w-md m-4 p-5 bg-white dark:bg-gray-800 rounded-lg text-center"><div class="w-12 h-12 rounded-full bg-yellow-100 text-yellow-600 mx-auto mb-3 flex items-center justify-center text-3xl">!</div><h3 id="confirmarEliminarTipoTitulo" class="text-lg font-semibold dark:text-white">Desactivar tipo de insumo</h3><p id="confirmarEliminarTipoMensaje" class="my-4 dark:text-white"></p><button type="button" data-cancel-delete-tipo class="py-2 px-3 bg-white border rounded-lg">Cancelar</button> <button type="button" data-confirm-delete-tipo class="py-2 px-3 text-white bg-red-600 rounded-lg">Desactivar</button><p id="confirmarEliminarTipoError" role="alert" class="text-red-600 mt-2"></p></div></div>
