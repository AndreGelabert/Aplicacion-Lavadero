@model List<Firebase.Models.SolicitudCotizacion>
@{
    ViewData["Title"] = "Cotizaciones";
    var proveedores = (ViewBag.Proveedores as List<Firebase.Models.Proveedor>) ?? new List<Firebase.Models.Proveedor>();
}
<section class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow">
    <div class="flex justify-between mb-4"><h1 class="text-2xl font-semibold dark:text-white">Solicitudes de cotización</h1><a asp-action="Index" class="text-blue-600">Volver</a></div>
    <h2>Crear solicitud</h2>
    @if ((bool)ViewBag.PuedeCrear)
    {
        <form method="post" asp-action="CrearSolicitudes">@Html.AntiForgeryToken()
            <fieldset><legend>Proveedores</legend>@foreach (var proveedor in (List<Firebase.Models.Proveedor>)ViewBag.Proveedores) { <label><input type="checkbox" name="proveedorIds" value="@proveedor.Id" /> @proveedor.RazonSocial</label> }</fieldset>
            <fieldset><legend>Insumos y cantidades</legend>
            @{ var insumos = (List<Firebase.Models.Insumo>)ViewBag.Insumos; }
            @for (var i = 0; i < insumos.Count; i++) { <label>@insumos[i].Nombre <input type="hidden" name="items[@i].InsumoId" value="@insumos[i].Id" /><input type="number" name="items[@i].Cantidad" min="0" step="any" value="0" /></label> }
            </fieldset><label>Notas <input name="notas" /></label><button>Crear solicitud</button>
        </form>
    }
    <div class="overflow-x-auto">
    <table class="w-full text-sm"><thead><tr class="border-b"><th class="text-left p-2">Grupo</th><th>Proveedor</th><th>Estado</th><th>Fecha</th><th></th></tr></thead><tbody>
    @foreach (var solicitud in Model)
    {
        <tr class="border-b"><td class="p-2"><a asp-action="Cotizaciones" asp-route-grupoId="@solicitud.GrupoId" class="text-blue-600">@solicitud.GrupoId</a></td><td>@solicitud.ProveedorId</td><td>@solicitud.Estado</td><td>@solicitud.Fecha.ToLocalTime().ToString("g")</td><td>
            @if (solicitud.Estado == "PendienteAprobacion")
            {
                <form method="post" asp-action="AprobarSolicitud">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@solicitud.Id" /><button class="text-orange-600">Aprobar</button></form>
            }
            @if (solicitud.Estado == "Pendiente")
            {
                <details><summary>Registrar respuesta</summary><form method="post" asp-action="RegistrarRespuesta">@Html.AntiForgeryToken()<input type="hidden" name="SolicitudId" value="@solicitud.Id" />
                @for (var i = 0; i < solicitud.Items.Count; i++) { <div>@solicitud.Items[i].NombreInsumo <input type="hidden" name="Items[@i].InsumoId" value="@solicitud.Items[i].InsumoId" /><label>Precio <input type="number" step="any" min="0" required name="Items[@i].PrecioUnitario" /></label><label>Disponibilidad <select name="Items[@i].Disponible"><option value="true">Disponible</option><option value="false">Sin disponibilidad</option></select></label></div> }
                <label>Plazo (días) <input type="number" min="0" required name="PlazoEntrega" /></label><label>Notas <input name="Notas" /></label><button>Registrar respuesta</button></form></details>
                <form method="post" asp-action="EnviarSolicitudEmail" class="ml-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@solicitud.Id" /><button class="text-blue-600">Enviar email</button></form>
            }
        </td></tr>
    }
    </tbody></table>
    </div>
    @if (!string.IsNullOrWhiteSpace((string?)ViewBag.GrupoId))
    {
        <h2 class="mt-6 mb-2 text-lg font-semibold dark:text-white">Comparación del grupo</h2>
        var comparaciones = (List<Firebase.Models.ComparacionCotizacion>)ViewBag.Comparacion;
        <div class="overflow-x-auto">
        <table aria-label="Comparación del grupo" class="w-full min-w-max text-sm text-left text-gray-500 dark:text-gray-400"><thead class="text-xs uppercase bg-gray-50 dark:bg-gray-700"><tr><th class="px-4 py-3">Proveedor</th><th>Estado</th><th>Detalle</th><th>Total</th><th>Plazo</th><th></th></tr></thead><tbody>
        @foreach (var item in comparaciones)
        {
            var proveedor = proveedores.FirstOrDefault(p => p.Id == item.Solicitud.ProveedorId);
            <tr class="border-b dark:border-gray-700"><td class="px-4 py-3">@(proveedor?.RazonSocial ?? item.Solicitud.ProveedorId)</td><td>@item.Solicitud.Estado</td><td>@if (item.Respuesta != null) { foreach (var detalle in item.Respuesta.Items) { <div>@detalle.NombreInsumo — Cantidad: @detalle.Cantidad — Precio unitario: @detalle.PrecioUnitario.ToString("N2") — @(detalle.Disponible ? "Disponible" : "Sin disponibilidad")</div> } }</td><td>@(item.Total == 0 ? "-" : item.Total.ToString("N2"))</td><td>@item.Respuesta?.PlazoEntrega</td><td>@if (item.Respuesta != null && (item.Solicitud.Estado == "Pendiente" || item.Solicitud.Estado == "Respondida")) { <form method="post" asp-action="Adjudicar">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Solicitud.Id" /><input type="hidden" name="respuestaId" value="@item.Respuesta.Id" /><button class="text-green-600">Adjudicar esta</button></form> }</td></tr>
        }
        </tbody></table>
        </div>
    }
</section>
