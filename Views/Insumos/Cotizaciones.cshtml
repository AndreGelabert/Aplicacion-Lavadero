@model List<Firebase.Models.SolicitudCotizacion>
@{
    ViewData["Title"] = "Cotizaciones";
    var proveedores = (ViewBag.Proveedores as List<Firebase.Models.Proveedor>) ?? new List<Firebase.Models.Proveedor>();
}
<section class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow">
    <div class="flex justify-between mb-4"><h1 class="text-2xl font-semibold dark:text-white">Solicitudes de cotización</h1><a asp-action="Index" class="app-button app-button--secondary"><svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>Volver</a></div>
    @if ((bool)ViewBag.PuedeCrear)
    {
        <div data-accordion="collapse"><h2><button type="button" data-accordion-target="#quotation-body" aria-controls="quotation-body" aria-expanded="false" class="flex items-center justify-between w-full p-2 py-5 font-medium text-gray-500 border-b dark:border-gray-700"><span>Registrando una Solicitud</span><svg data-accordion-icon class="w-3 h-3" fill="none" viewBox="0 0 10 6"><path stroke="currentColor" stroke-width="2" d="M9 5 5 1 1 5" /></svg></button></h2><div id="quotation-body" class="hidden">
        <form method="post" asp-action="CrearSolicitudes" class="mt-4 space-y-4 text-sm text-gray-700 dark:text-gray-300">@Html.AntiForgeryToken()
            <fieldset class="border rounded-lg p-3 dark:border-gray-600"><legend>Proveedores</legend><div class="grid gap-2 sm:grid-cols-2">@foreach (var proveedor in proveedores) { <label class="flex items-center gap-2"><input type="checkbox" name="proveedorIds" value="@proveedor.Id" /> @proveedor.RazonSocial</label> }</div></fieldset>
            <div id="quotation-picker" class="m-4"><label for="quotation-search" class="block mb-2 text-sm font-medium dark:text-white">Insumos de la Solicitud</label><div class="bg-gray-50 border border-gray-300 rounded-lg p-3 dark:bg-gray-700"><div class="flex gap-2 mb-3"><div class="flex-1 relative"><input id="quotation-search" type="search" autocomplete="off" placeholder="Buscar insumo por nombre..." class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-600 dark:text-white" /><div id="quotation-dropdown" class="hidden absolute z-10 w-full mt-1 bg-white dark:bg-gray-700 border rounded-lg shadow-lg max-h-80 overflow-y-auto">@foreach (var insumo in (List<Firebase.Models.Insumo>)ViewBag.Insumos) { <button type="button" data-quotation-option data-id="@insumo.Id" data-name="@insumo.Nombre" data-unit="@insumo.UnidadMedida" class="block w-full text-left px-2 py-2 hover:bg-gray-100 dark:hover:bg-gray-600">@insumo.Nombre</button> }</div></div><button type="button" id="quotation-add" class="text-white bg-blue-600 hover:bg-blue-700 rounded-lg px-5 py-2.5">+ Agregar</button></div></div><label class="block mb-2 mt-4 text-sm font-medium dark:text-white">Insumos Seleccionados</label><div id="quotation-selected" class="bg-gray-50 border border-gray-300 rounded-lg p-3 dark:bg-gray-700"></div><p id="quotation-error" role="alert" class="text-red-600 text-sm"></p></div><label class="block">Notas <input name="notas" class="block w-full rounded border p-2 dark:bg-gray-700" /></label><button class="app-button app-button--primary"><svg aria-hidden="true" class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>Crear solicitud</button>
        </form></div></div>
    }
    <div class="overflow-x-auto">
    <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400" data-finite-table><thead class="text-xs uppercase bg-gray-50 dark:bg-gray-700"><tr class="border-b"><th class="text-left p-2 select-none"><button type="button" data-sort-column="0" class="flex items-center gap-1">Grupo <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 3l4 5H6l4-5zm0 14-4-5h8l-4 5z" /></svg></button></th><th>Proveedor</th><th>Estado</th><th><button type="button" data-sort-column="3" data-sort-type="date" class="flex items-center gap-1">Fecha <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3l4 5H6l4-5zm0 14-4-5h8l-4 5z" /></svg></button></th><th></th></tr></thead><tbody>
    @foreach (var solicitud in Model)
    {
        <tr class="border-b"><td class="p-2"><a asp-action="Cotizaciones" asp-route-grupoId="@solicitud.GrupoId" class="text-blue-600">@solicitud.GrupoId</a></td><td>@solicitud.ProveedorId</td><td><span class="@(solicitud.Estado.StartsWith("Pendiente") || solicitud.Estado == "Enviada" ? "bg-yellow-100 text-yellow-800" : solicitud.Estado == "Cancelada" ? "bg-red-100 text-red-800" : solicitud.Estado == "Respondida" ? "bg-green-100 text-green-800" : "bg-blue-100 text-blue-800") text-xs font-medium px-2.5 py-0.5 rounded-full">@solicitud.Estado</span></td><td data-sort-value="@solicitud.Fecha.ToUniversalTime().ToString("O")">@solicitud.Fecha.ToLocalTime().ToString("g")</td><td>
            @if (solicitud.Estado == "PendienteAprobacion")
            {
                <form method="post" asp-action="AprobarSolicitud">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@solicitud.Id" /><button aria-label="Aprobar" title="Aprobar" class="p-1.5 text-white bg-blue-600 rounded-lg"><svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12l4 4L19 6" /></svg></button></form>
            }
            @if (solicitud.Estado == "Pendiente")
            {
                <button type="button" data-open-modal="response-@solicitud.Id" aria-label="Registrar respuesta" class="p-1.5 text-white bg-blue-600 rounded-lg"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M16 4l4 4L7 21H3v-4z" /></svg></button>
                <form method="post" asp-action="EnviarSolicitudEmail" class="ml-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@solicitud.Id" /><button aria-label="Enviar email" title="Enviar email" class="p-1.5 text-white bg-blue-600 rounded-lg"><svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6l9 7 9-7M4 5h16v14H4z" /></svg></button></form>
            }
        </td></tr>
    }
    </tbody></table>
    </div>
    @foreach (var solicitud in Model.Where(s => s.Estado == "Pendiente")) {
    <div id="response-@solicitud.Id" role="dialog" aria-modal="true" aria-hidden="true" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50"><div class="p-4 bg-white dark:bg-gray-800 rounded-lg max-h-full overflow-y-auto"><button type="button" data-close-modal aria-label="Cerrar">✕</button><h2>Registrar respuesta</h2><form method="post" asp-action="RegistrarRespuesta" class="space-y-2 mt-2">@Html.AntiForgeryToken()<input type="hidden" name="SolicitudId" value="@solicitud.Id" />
    @for (var i = 0; i < solicitud.Items.Count; i++) { <div>@solicitud.Items[i].NombreInsumo <input type="hidden" name="Items[@i].InsumoId" value="@solicitud.Items[i].InsumoId" /><label>Precio <input type="number" step="any" min="0" required name="Items[@i].PrecioUnitario" /></label><label>Disponibilidad <select name="Items[@i].Disponible"><option value="true">Disponible</option><option value="false">Sin disponibilidad</option></select></label></div> }
    <label>Plazo (días) <input type="number" min="0" required name="PlazoEntrega" /></label><label>Notas <input name="Notas" /></label><button class="app-button app-button--primary">Registrar respuesta</button></form></div></div>
    }
    @if (!string.IsNullOrWhiteSpace((string?)ViewBag.GrupoId))
    {
        <h2 class="mt-6 mb-2 text-lg font-semibold dark:text-white">Comparación del grupo</h2>
        var comparaciones = (List<Firebase.Models.ComparacionCotizacion>)ViewBag.Comparacion;
        <div class="overflow-x-auto">
        <table aria-label="Comparación del grupo" class="w-full min-w-max text-sm text-left text-gray-500 dark:text-gray-400" data-finite-table><thead class="text-xs uppercase bg-gray-50 dark:bg-gray-700"><tr><th class="px-4 py-3">Proveedor</th><th>Estado</th><th>Detalle</th><th><button type="button" data-sort-column="3" data-sort-type="number" class="flex items-center gap-1">Total <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3l4 5H6l4-5zm0 14-4-5h8l-4 5z" /></svg></button></th><th><button type="button" data-sort-column="4" data-sort-type="number" class="flex items-center gap-1">Plazo <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3l4 5H6l4-5zm0 14-4-5h8l-4 5z" /></svg></button></th><th></th></tr></thead><tbody>
        @foreach (var item in comparaciones)
        {
            var proveedor = proveedores.FirstOrDefault(p => p.Id == item.Solicitud.ProveedorId);
            <tr class="border-b dark:border-gray-700"><td class="px-4 py-3">@(proveedor?.RazonSocial ?? item.Solicitud.ProveedorId)</td><td><span class="@(item.Solicitud.Estado.StartsWith("Pendiente") ? "bg-yellow-100 text-yellow-800" : item.Solicitud.Estado == "Cancelada" ? "bg-red-100 text-red-800" : item.Solicitud.Estado == "Respondida" ? "bg-green-100 text-green-800" : "bg-blue-100 text-blue-800") text-xs font-medium px-2.5 py-0.5 rounded-full">@item.Solicitud.Estado</span></td><td>@if (item.Respuesta != null) { foreach (var detalle in item.Respuesta.Items) { <div>@detalle.NombreInsumo — Cantidad: @detalle.Cantidad — Precio unitario: @detalle.PrecioUnitario.ToString("N2") — @(detalle.Disponible ? "Disponible" : "Sin disponibilidad")</div> } }</td><td data-sort-value="@item.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)">@(item.Total == 0 ? "-" : item.Total.ToString("N2"))</td><td data-sort-value="@(item.Respuesta?.PlazoEntrega.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">@item.Respuesta?.PlazoEntrega</td><td>@if (item.Respuesta != null && (item.Solicitud.Estado == "Pendiente" || item.Solicitud.Estado == "Respondida")) { <form method="post" asp-action="Adjudicar">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Solicitud.Id" /><input type="hidden" name="respuestaId" value="@item.Respuesta.Id" /><button aria-label="Adjudicar esta solicitud" title="Adjudicar" class="p-1.5 text-white bg-blue-600 rounded-lg"><svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12l4 4L19 6" /></svg></button></form> }</td></tr>
        }
        </tbody></table>
        </div>
    }
</section>
<script src="~/js/insumos-secondary.js" asp-append-version="true"></script>
