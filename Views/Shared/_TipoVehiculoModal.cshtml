@using Firebase.Security
@{
    var puedeCrear = User.TieneAlgunPermiso("Vehiculos.Crear", "Servicios.Crear");
    var puedeEditar = User.TieneAlgunPermiso("Vehiculos.Modificar", "Servicios.Modificar");
    var puedeDesactivar = User.TieneAlgunPermiso("Vehiculos.Modificar", "Vehiculos.Eliminar", "Servicios.Modificar", "Servicios.Eliminar");
}
@if (puedeCrear || puedeEditar || puedeDesactivar)
{
<div id="tipoVehiculoModal" tabindex="-1" aria-hidden="true" aria-labelledby="tiposVehiculoTitulo"
     class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-[60] flex justify-center items-center w-full md:inset-0 h-modal md:h-full"
     data-list-url="@Url.Action("ModalDatos", "TipoVehiculo")"
     data-save-url="@Url.Action("ModalGuardar", "TipoVehiculo")"
     data-state-url="@Url.Action("ModalEstado", "TipoVehiculo")"
     data-can-edit="@puedeEditar.ToString().ToLowerInvariant()"
     data-can-toggle="@puedeDesactivar.ToString().ToLowerInvariant()">
    <div class="relative p-4 w-full max-w-2xl">
        <div class="relative p-4 bg-white rounded-lg shadow dark:bg-gray-800 sm:p-5" style="max-height: calc(100vh - 2rem); overflow-y: auto;">
            <div class="flex justify-between items-center pb-4 mb-4 border-b dark:border-gray-600">
                <h3 id="tiposVehiculoTitulo" class="text-lg font-semibold text-gray-900 dark:text-white">Tipos de vehículo</h3>
                <button type="button" data-modal-hide="tipoVehiculoModal" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 ml-auto inline-flex items-center dark:hover:bg-gray-600 dark:hover:text-white" aria-label="Cerrar tipos de vehículo">
                    <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                </button>
            </div>
            <p id="tiposVehiculoMensaje" role="status" aria-live="polite" class="mb-3 text-sm dark:text-white"></p>
            @if (puedeCrear || puedeEditar)
            {
            <form id="tipoVehiculoAbmForm" method="post" class="grid sm:grid-cols-2 gap-3 mb-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="crear" value="true" />
                <input type="hidden" name="Id" />
                <div class="sm:col-span-2">
                    <label for="nombreTipoVehiculo" class="block mb-1 text-sm font-medium text-gray-900 dark:text-white">Nombre <span class="text-red-600">*</span></label>
                    <input type="text" name="Nombre" id="nombreTipoVehiculo"
                           class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
                           placeholder="Ej: Automóvil, Camioneta" minlength="3" required />
                </div>
                <div>
                    <label for="formatoPatenteAbm" class="block mb-1 text-sm font-medium text-gray-900 dark:text-white">Formato de Patente <span class="text-red-600">*</span></label>
                    <input type="text" name="FormatoPatente" id="formatoPatenteAbm"
                           class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
                           placeholder="Ej: llnnnll|lllnnn" minlength="3" pattern="^[nNlL.\-|]+$" required />
                </div>
                <div>
                    <label for="cantidadEmpleadosAbm" class="block mb-1 text-sm font-medium text-gray-900 dark:text-white">Empleados Requeridos <span class="text-red-600">*</span></label>
                    <input type="number" name="CantidadEmpleadosRequeridos" id="cantidadEmpleadosAbm"
                           class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
                           min="1" max="10" value="1" required />
                </div>
                <div class="flex justify-end gap-2 sm:col-span-2">
                    <button type="submit" class="app-button app-button--success">Guardar tipo</button>
                    <button type="button" data-reset-tipo class="app-button app-button--secondary">Limpiar</button>
                    <button type="button" data-modal-hide="tipoVehiculoModal" class="app-button app-button--danger">Cancelar</button>
                </div>
            </form>
            }
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left dark:text-gray-200">
                    <thead class="bg-gray-50 dark:bg-gray-700">
                        <tr><th class="px-3 py-2">Nombre</th><th class="px-3 py-2">Formato</th><th class="px-3 py-2">Empleados</th><th class="px-3 py-2">Estado</th><th class="px-3 py-2">Acciones</th></tr>
                    </thead>
                    <tbody id="tiposVehiculoTabla"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
}
