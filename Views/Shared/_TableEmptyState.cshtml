@model (string Message, string Detail)
<div data-table-empty-state class="flex flex-col items-center bg-white dark:bg-gray-800 px-4 py-8 text-center text-gray-500 dark:text-gray-400">
    <svg class="w-16 h-16 mb-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
    </svg>
    <p class="text-lg font-medium">@Model.Message</p>
    @if (!string.IsNullOrEmpty(Model.Detail))
    {
        <p class="text-sm">@Model.Detail</p>
    }
</div>
