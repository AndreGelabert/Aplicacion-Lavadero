@model List<Firebase.Models.TurnoConsultaViewModel>
@{
    var zona = Firebase.Utils.TimeZoneHelper.ArgentinaZone;
}
<div class="overflow-x-auto" role="region" aria-label="Tabla de turnos" tabindex="0">
    <input type="hidden" id="current-sort-by" value="@ViewBag.SortBy" />
    <input type="hidden" id="current-sort-order" value="@ViewBag.SortOrder" />
    <input type="hidden" id="current-page-value" value="@ViewBag.CurrentPage" />
    <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
        <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
            <tr>
                <th scope="col" class="px-4 py-3 select-none">
                    <div class="flex items-center gap-1">
                        <span>Cliente</span>
                        <a asp-action="Index" asp-route-sortBy="Cliente" class="sort-icon-container cursor-pointer text-inherit no-underline" onclick="event.preventDefault(); sortTurnoTable('Cliente');">
                            <svg class="w-4 h-4 @(ViewBag.SortBy == "Cliente" ? "text-gray-700 dark:text-gray-300" : "text-gray-400 dark:text-gray-500") hover:text-gray-600 dark:hover:text-gray-400 transition-colors"
                                 fill="currentColor" viewBox="0 0 20 20">
                                <path clip-rule="evenodd" fill-rule="evenodd" d="M10 3a.75.75 0 01.55.24l3.25 3.5a.75.75 0 11-1.1 1.02L10 4.852 7.3 7.76a.75.75 0 01-1.1-1.02l3.25-3.5A.75.75 0 0110 3zm-3.76 9.2a.75.75 0 011.06.04l2.7 2.908 2.7-2.908a.75.75 0 111.1 1.02l-3.25 3.5a.75.75 0 01-1.1 0l-3.25-3.5a.75.75 0 01.04-1.06z"></path>
                            </svg>
                        </a>
                    </div>
                </th>
                <th scope="col" class="px-4 py-3 select-none">
                    <div class="flex items-center gap-1">
                        <span>Vehículo</span>
                        <a asp-action="Index" asp-route-sortBy="Vehiculo" class="sort-icon-container cursor-pointer text-inherit no-underline" onclick="event.preventDefault(); sortTurnoTable('Vehiculo');">
                            <svg class="w-4 h-4 @(ViewBag.SortBy == "Vehiculo" ? "text-gray-700 dark:text-gray-300" : "text-gray-400 dark:text-gray-500") hover:text-gray-600 dark:hover:text-gray-400 transition-colors"
                                 fill="currentColor" viewBox="0 0 20 20">
                                <path clip-rule="evenodd" fill-rule="evenodd" d="M10 3a.75.75 0 01.55.24l3.25 3.5a.75.75 0 11-1.1 1.02L10 4.852 7.3 7.76a.75.75 0 01-1.1-1.02l3.25-3.5A.75.75 0 0110 3zm-3.76 9.2a.75.75 0 011.06.04l2.7 2.908 2.7-2.908a.75.75 0 111.1 1.02l-3.25 3.5a.75.75 0 01-1.1 0l-3.25-3.5a.75.75 0 01.04-1.06z"></path>
                            </svg>
                        </a>
                    </div>
                </th>
                <th scope="col" class="px-4 py-3 select-none">
                    <div class="flex items-center gap-1">
                        <span>Fecha y hora</span>
                        <a asp-action="Index" asp-route-sortBy="Fecha" class="sort-icon-container cursor-pointer text-inherit no-underline" onclick="event.preventDefault(); sortTurnoTable('Fecha');">
                            <svg class="w-4 h-4 @(ViewBag.SortBy == "Fecha" ? "text-gray-700 dark:text-gray-300" : "text-gray-400 dark:text-gray-500") hover:text-gray-600 dark:hover:text-gray-400 transition-colors"
                                 fill="currentColor" viewBox="0 0 20 20">
                                <path clip-rule="evenodd" fill-rule="evenodd" d="M10 3a.75.75 0 01.55.24l3.25 3.5a.75.75 0 11-1.1 1.02L10 4.852 7.3 7.76a.75.75 0 01-1.1-1.02l3.25-3.5A.75.75 0 0110 3zm-3.76 9.2a.75.75 0 011.06.04l2.7 2.908 2.7-2.908a.75.75 0 111.1 1.02l-3.25 3.5a.75.75 0 01-1.1 0l-3.25-3.5a.75.75 0 01.04-1.06z"></path>
                            </svg>
                        </a>
                    </div>
                </th>
                <th scope="col" class="px-4 py-3 select-none">Servicios</th>
                <th scope="col" class="px-4 py-3 select-none">
                    <div class="flex items-center gap-1">
                        <span>Precio</span>
                        <a asp-action="Index" asp-route-sortBy="Precio" class="sort-icon-container cursor-pointer text-inherit no-underline" onclick="event.preventDefault(); sortTurnoTable('Precio');">
                            <svg class="w-4 h-4 @(ViewBag.SortBy == "Precio" ? "text-gray-700 dark:text-gray-300" : "text-gray-400 dark:text-gray-500") hover:text-gray-600 dark:hover:text-gray-400 transition-colors"
                                 fill="currentColor" viewBox="0 0 20 20">
                                <path clip-rule="evenodd" fill-rule="evenodd" d="M10 3a.75.75 0 01.55.24l3.25 3.5a.75.75 0 11-1.1 1.02L10 4.852 7.3 7.76a.75.75 0 01-1.1-1.02l3.25-3.5A.75.75 0 0110 3zm-3.76 9.2a.75.75 0 011.06.04l2.7 2.908 2.7-2.908a.75.75 0 111.1 1.02l-3.25 3.5a.75.75 0 01-1.1 0l-3.25-3.5a.75.75 0 01.04-1.06z"></path>
                            </svg>
                        </a>
                    </div>
                </th>
                <th scope="col" class="px-4 py-3 select-none">
                    <div class="flex items-center gap-1">
                        <span>Estado</span>
                        <a asp-action="Index" asp-route-sortBy="Estado" class="sort-icon-container cursor-pointer text-inherit no-underline" onclick="event.preventDefault(); sortTurnoTable('Estado');">
                            <svg class="w-4 h-4 @(ViewBag.SortBy == "Estado" ? "text-gray-700 dark:text-gray-300" : "text-gray-400 dark:text-gray-500") hover:text-gray-600 dark:hover:text-gray-400 transition-colors"
                                 fill="currentColor" viewBox="0 0 20 20">
                                <path clip-rule="evenodd" fill-rule="evenodd" d="M10 3a.75.75 0 01.55.24l3.25 3.5a.75.75 0 11-1.1 1.02L10 4.852 7.3 7.76a.75.75 0 01-1.1-1.02l3.25-3.5A.75.75 0 0110 3zm-3.76 9.2a.75.75 0 011.06.04l2.7 2.908 2.7-2.908a.75.75 0 111.1 1.02l-3.25 3.5a.75.75 0 01-1.1 0l-3.25-3.5a.75.75 0 01.04-1.06z"></path>
                            </svg>
                        </a>
                    </div>
                </th>
                <th scope="col" class="px-4 py-3 text-center select-none">Acciones</th>
            </tr>
        </thead>
        <tbody id="turno-table-body">
        @foreach (var turno in Model)
        {
            var patentes = string.Join(", ", turno.Vehiculos.Select(v => v.Patente).Where(p => !string.IsNullOrEmpty(p)));
            var servicios = string.Join(", ", turno.Vehiculos.SelectMany(v => v.Servicios.Select(s => s.Nombre)).Where(n => !string.IsNullOrEmpty(n)));
            <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600" data-estado="@turno.Estado">
                <td class="px-4 py-3 font-medium text-gray-900 dark:text-white">@turno.Cliente</td>
                <td class="px-4 py-3">@(string.IsNullOrEmpty(patentes) ? "—" : patentes)</td>
                <td class="px-4 py-3 whitespace-nowrap">@TimeZoneInfo.ConvertTimeFromUtc(turno.InicioUtc, zona).ToString("dd/MM/yyyy HH:mm")</td>
                <td class="px-4 py-3 max-w-xs truncate" title="@servicios">@(string.IsNullOrEmpty(servicios) ? "—" : servicios)</td>
                <td class="px-4 py-3 font-semibold text-gray-900 dark:text-white">@turno.PrecioAcordado.ToString("C")</td>
                <td class="px-4 py-3 whitespace-nowrap">
                    @switch (turno.Estado)
                    {
                        case "Pendiente":
                            <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-yellow-900 dark:text-yellow-300">@turno.Estado</span>
                            break;
                        case "EnProceso":
                            <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">En Proceso</span>
                            break;
                        case "Completado":
                            <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-green-900 dark:text-green-300">@turno.Estado</span>
                            break;
                        case "Cancelado":
                        case "Ausente":
                            <span class="bg-red-100 text-red-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-red-900 dark:text-red-300">@turno.Estado</span>
                            break;
                        default:
                            <span class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-gray-900 dark:text-gray-300">@turno.Estado</span>
                            break;
                    }
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-center">
                    <div class="flex items-center justify-center gap-1">
                        <a asp-action="Detalle" asp-route-id="@turno.Id" class="p-1.5 text-white bg-purple-600 rounded-lg hover:bg-purple-700 transition-colors inline-flex items-center" title="Ver detalle">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </a>
                        @if (turno.Estado == "Pendiente" && User.TienePermiso("Turnos.Consultar") && User.TienePermiso("Turnos.Modificar"))
                        {
                            <a asp-action="Index" asp-route-editar="@turno.Id" data-turno-editar="@turno.Id" class="p-1.5 text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-colors inline-flex items-center" title="Editar turno" aria-label="Editar turno">
                                <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487a2.1 2.1 0 013 3L9 18.347 5 19l.653-4L16.862 4.487z"></path></svg>
                            </a>
                        }
                        @if (turno.Estado == "Pendiente" && User.TienePermiso("Turnos.Consultar") && User.TienePermiso("Turnos.Cancelar"))
                        {
                            <button type="button" data-turno-cancelacion data-turno-id="@turno.Id" class="p-1.5 text-white bg-red-600 rounded-lg hover:bg-red-700 transition-colors" title="Cancelar turno" aria-label="Cancelar turno">
                                <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        }
                    </div>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="p-4 text-center text-gray-500 dark:text-gray-400">No hay turnos registrados.</td></tr>
        }
        </tbody>
    </table>
</div>

<!-- Paginación -->
<nav class="flex flex-col md:flex-row justify-between items-start md:items-center space-y-3 md:space-y-0 p-4" aria-label="Table navigation">
    <span class="text-sm font-normal text-gray-500 dark:text-gray-400">
        Mostrando página
        <span class="font-semibold text-gray-900 dark:text-white">@(ViewBag.CurrentPage ?? 1)</span>
        de
        <span class="font-semibold text-gray-900 dark:text-white">@(ViewBag.TotalPages ?? 1)</span>
    </span>

    <ul class="inline-flex items-stretch -space-x-px">
        <li>
            @if ((ViewBag.CurrentPage ?? 1) > 1)
            {
                <button type="button" onclick="reloadTurnoTable(@((ViewBag.CurrentPage ?? 1) - 1))"
                        class="flex items-center justify-center h-full py-1.5 px-3 ml-0 text-gray-500 bg-white rounded-l-lg border border-gray-300 hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white" aria-label="Anterior">
                    <svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                </button>
            }
            else
            {
                <span class="flex items-center justify-center h-full py-1.5 px-3 ml-0 text-gray-300 bg-white rounded-l-lg border border-gray-300 cursor-not-allowed dark:bg-gray-800 dark:border-gray-700">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                </span>
            }
        </li>

        @if (ViewBag.VisiblePages != null)
        {
            foreach (var pageNum in (IEnumerable<int>)ViewBag.VisiblePages)
            {
                <li>
                    @if (pageNum == (int)(ViewBag.CurrentPage ?? 1))
                    {
                        <span class="flex items-center justify-center text-sm z-10 py-2 px-3 leading-tight text-primary-600 bg-primary-50 border border-primary-300 dark:border-gray-700 dark:bg-gray-700 dark:text-white font-semibold">
                            @pageNum
                        </span>
                    }
                    else
                    {
                        <button type="button" onclick="reloadTurnoTable(@pageNum)"
                                class="flex items-center justify-center text-sm py-2 px-3 leading-tight text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white">
                            @pageNum
                        </button>
                    }
                </li>
            }
        }
        else
        {
            <li>
                <span class="flex items-center justify-center text-sm z-10 py-2 px-3 leading-tight text-primary-600 bg-primary-50 border border-primary-300 dark:border-gray-700 dark:bg-gray-700 dark:text-white font-semibold">
                    1
                </span>
            </li>
        }

        <li>
            @if ((ViewBag.CurrentPage ?? 1) < (ViewBag.TotalPages ?? 1))
            {
                <button type="button" onclick="reloadTurnoTable(@((ViewBag.CurrentPage ?? 1) + 1))"
                        class="flex items-center justify-center h-full py-1.5 px-3 leading-tight text-gray-500 bg-white rounded-r-lg border border-gray-300 hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white" aria-label="Siguiente">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                    </svg>
                </button>
            }
            else
            {
                <span class="flex items-center justify-center h-full py-1.5 px-3 leading-tight text-gray-300 bg-white rounded-r-lg border border-gray-300 cursor-not-allowed dark:bg-gray-800 dark:border-gray-700">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                    </svg>
                </span>
            }
        </li>
    </ul>
</nav>
