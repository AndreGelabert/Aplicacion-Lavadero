@model Firebase.Models.TurnoConsultaViewModel
@{
    ViewData["Title"] = "Detalle del turno";
    var zona = Firebase.Utils.TimeZoneHelper.ArgentinaZone;
}
<section class="bg-gray-50 dark:bg-gray-900 min-h-screen py-8">
    <div class="max-w-7xl mx-auto px-4">
        <div class="mb-6 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
            <div class="flex min-w-0 flex-wrap items-center gap-4">
                <a asp-action="Index" class="inline-flex items-center text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    Volver a turnos
                </a>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Detalle del turno</h1>
            </div>
            <div class="flex flex-wrap items-start gap-2">
                @if (Model.Estado == "Pendiente" && User.TienePermiso("Turnos.Consultar") && User.TienePermiso("Turnos.Modificar"))
                {
                    @if (!string.IsNullOrEmpty(Model.VersionEsperada))
                    {
                        <a asp-action="Index" asp-route-editar="@Model.Id" class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium">
                            <svg aria-hidden="true" class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.862 4.487a2.1 2.1 0 013 3L9 18.347 5 19l.653-4L16.862 4.487z" />
                            </svg>
                            Editar turno
                        </a>
                    }
                }
                @if (Model.Estado == "Pendiente" && User.TienePermiso("Turnos.Consultar") && User.TienePermiso("Turnos.Cancelar"))
                {
                    <button type="button" data-turno-cancelacion class="inline-flex items-center px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-lg focus:ring-4 focus:ring-red-300 dark:focus:ring-red-900">
                        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                        </svg>
                        Cancelar turno
                    </button>
                }
                @if (Model.Estado == "Pendiente" && User.TienePermiso("Turnos.Consultar") && User.TienePermiso("Turnos.Modificar") && User.TienePermiso("Lavados.Crear") && User.TienePermiso("Lavados.Modificar"))
                {
                    var estaEnVentana = ViewBag.EstaEnVentanaInicioTurno as bool? ?? true;
                    var motivoInhabilitado = ViewBag.MotivoVentanaInicioTurno as string;
                    if (estaEnVentana)
                    {
                        <button type="button" data-turno-inicio class="inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg focus:ring-4 focus:ring-green-300">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Iniciar lavado
                        </button>
                    }
                    else
                    {
                        <div class="inline-flex flex-col items-start sm:items-end">
                            <button type="button" data-turno-inicio disabled title="@motivoInhabilitado" class="inline-flex items-center px-4 py-2 bg-gray-400 dark:bg-gray-600 text-white text-sm font-medium rounded-lg cursor-not-allowed opacity-60">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                Iniciar lavado
                            </button>
                            <span class="text-xs text-amber-600 dark:text-amber-400 mt-1">@motivoInhabilitado</span>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <div class="grid gap-4 md:grid-cols-2">
                <!-- Información General -->
                <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
                    <h2 class="text-md font-semibold text-gray-900 dark:text-white mb-3">Información General</h2>
                    <dl class="space-y-2 text-sm">
                        <div class="flex justify-between gap-4">
                            <dt class="text-gray-600 dark:text-gray-400">Cliente:</dt>
                            <dd class="font-medium text-gray-900 dark:text-white">@Model.Cliente</dd>
                        </div>
                        <div class="flex justify-between gap-4 items-center">
                            <dt class="text-gray-600 dark:text-gray-400">Estado:</dt>
                            <dd>
                                @switch (Model.Estado)
                                {
                                    case "Pendiente":
                                        <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-yellow-900 dark:text-yellow-300">Pendiente</span>
                                        break;
                                    case "EnProceso":
                                        <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">En Proceso</span>
                                        break;
                                    case "Completado":
                                        <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-green-900 dark:text-green-300">Completado</span>
                                        break;
                                    case "Cancelado":
                                    case "Ausente":
                                        <span class="bg-red-100 text-red-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-red-900 dark:text-red-300">@Model.Estado</span>
                                        break;
                                    default:
                                        <span class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-gray-900 dark:text-gray-300">@Model.Estado</span>
                                        break;
                                }
                            </dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt class="text-gray-600 dark:text-gray-400">Inicio (Buenos Aires):</dt>
                            <dd class="font-medium text-gray-900 dark:text-white">@TimeZoneInfo.ConvertTimeFromUtc(Model.InicioUtc, zona).ToString("dd/MM/yyyy HH:mm")</dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt class="text-gray-600 dark:text-gray-400">Fin (Buenos Aires):</dt>
                            <dd class="font-medium text-gray-900 dark:text-white">@TimeZoneInfo.ConvertTimeFromUtc(Model.FinUtc, zona).ToString("dd/MM/yyyy HH:mm")</dd>
                        </div>
                        <div class="flex justify-between gap-4 items-center">
                            <dt class="text-gray-600 dark:text-gray-400">Acepta adelanto:</dt>
                            <dd>
                                @if (Model.AceptaAdelanto)
                                {
                                    <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-green-900 dark:text-green-300">Sí</span>
                                }
                                else
                                {
                                    <span class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-gray-900 dark:text-gray-300">No</span>
                                }
                            </dd>
                        </div>
                    </dl>
                </div>

                <!-- Información de Precio -->
                <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg flex flex-col justify-between">
                    <div>
                        <h2 class="text-md font-semibold text-gray-900 dark:text-white mb-3">Información de Precio</h2>
                        <div class="space-y-2 text-sm">
                            @if (Model.Descuento > 0)
                            {
                                <div class="flex justify-between">
                                    <span class="text-gray-600 dark:text-gray-400">Descuento aplicado:</span>
                                    <span class="font-medium text-green-600 dark:text-green-400">-@Model.Descuento%</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="pt-3 border-t border-gray-200 dark:border-gray-600 flex justify-between items-baseline mt-4">
                        <span class="text-gray-600 dark:text-gray-400 text-sm font-medium">Precio acordado:</span>
                        <span class="font-bold text-2xl text-gray-900 dark:text-white">@Model.PrecioAcordado.ToString("C")</span>
                    </div>
                </div>
            </div>

            <!-- Empleados Asignados -->
            <div class="mt-4 bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
                <h2 class="text-md font-semibold text-gray-900 dark:text-white mb-3">Empleados Asignados (@(Model.EmpleadosAsignados?.Count ?? 0))</h2>
                <div class="flex flex-wrap items-start gap-2">
                    @if (Model.EmpleadosAsignados?.Count > 0)
                    {
                        @foreach (var emp in Model.EmpleadosAsignados)
                        {
                            <span class="bg-blue-100 text-blue-800 text-sm font-medium px-3 py-1 rounded-full dark:bg-blue-900 dark:text-blue-300">
                                @emp
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-sm text-gray-500 dark:text-gray-400 italic">No hay empleados asignados para este turno.</span>
                    }
                </div>
            </div>

            <!-- Vehículos y Servicios -->
            @foreach (var vehiculo in Model.Vehiculos)
            {
                <div class="mt-4 bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                        <h2 class="text-md font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                            <svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                            </svg>
                            Vehículo: <span class="font-bold">@vehiculo.Patente</span>
                        </h2>
                        <span class="text-xs bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 font-medium px-2.5 py-1 rounded inline-block self-start sm:self-auto">
                            Empleados requeridos: @vehiculo.CantidadEmpleadosRequeridos
                        </span>
                    </div>

                    <h3 class="text-sm font-semibold text-gray-900 dark:text-white mt-4 mb-2">Servicios (@vehiculo.Servicios.Count)</h3>
                    <div class="space-y-2">
                        @foreach (var servicio in vehiculo.Servicios)
                        {
                            <div class="bg-white dark:bg-gray-800 p-3 rounded-lg border-l-4 border-blue-500 shadow-sm flex justify-between items-center">
                                <div>
                                    <h4 class="font-medium text-gray-900 dark:text-white text-sm">@servicio.Nombre</h4>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                                        Tiempo estimado: @servicio.TiempoEstimado min • @servicio.Precio.ToString("C")
                                    </p>
                                </div>
                                <span class="font-semibold text-gray-900 dark:text-white text-sm">
                                    @servicio.Precio.ToString("C")
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>
@if (Model.Estado == "Pendiente" && User.TienePermiso("Turnos.Consultar") && User.TienePermiso("Turnos.Cancelar"))
{
    @await Html.PartialAsync("_TurnoCancelacion", Model)
    <script src="~/js/turno-cancelacion.js" asp-append-version="true"></script>
}
@if (Model.Estado == "Pendiente" && User.TienePermiso("Turnos.Consultar") && User.TienePermiso("Turnos.Modificar") && User.TienePermiso("Lavados.Crear") && User.TienePermiso("Lavados.Modificar"))
{
    @await Html.PartialAsync("_TurnoInicio", Model)
    <script src="~/js/turno-inicio.js" asp-append-version="true"></script>
}
