@model Firebase.Models.TurnoConsultaViewModel
@{
    ViewData["Title"] = "Detalle del turno";
    var zona = Firebase.Utils.TimeZoneHelper.ArgentinaZone;
}
<section class="bg-gray-50 dark:bg-gray-900 min-h-screen py-8">
    <div class="max-w-7xl mx-auto px-4">
        <div class="mb-6 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
            <div class="flex min-w-0 flex-wrap items-center gap-4">
                <a asp-action="Index" class="inline-flex items-center text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300">Volver a turnos</a>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Detalle del turno</h1>
            </div>
            @if (Model.Estado == "Pendiente" && User.TienePermiso("Turnos.Consultar") && User.TienePermiso("Turnos.Modificar"))
            {
                @if (!string.IsNullOrEmpty(Model.VersionEsperada))
                {
                    <a asp-action="Index" asp-route-editar="@Model.Id" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg"><svg aria-hidden="true" class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.862 4.487a2.1 2.1 0 013 3L9 18.347 5 19l.653-4L16.862 4.487z" /></svg>Editar turno</a>
                }
            }
            @if (Model.Estado == "Pendiente" && User.TienePermiso("Turnos.Consultar") && User.TienePermiso("Turnos.Cancelar"))
            {
                <button type="button" data-turno-cancelacion class="inline-flex items-center px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-lg focus:ring-4 focus:ring-red-300 dark:focus:ring-red-900">Cancelar turno</button>
            }
            @if (Model.Estado == "Pendiente" && User.TienePermiso("Turnos.Consultar") && User.TienePermiso("Turnos.Modificar") && User.TienePermiso("Lavados.Crear") && User.TienePermiso("Lavados.Modificar"))
            {
                var estaEnVentana = ViewBag.EstaEnVentanaInicioTurno as bool? ?? true;
                var motivoInhabilitado = ViewBag.MotivoVentanaInicioTurno as string;
                if (estaEnVentana)
                {
                    <button type="button" data-turno-inicio class="inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg focus:ring-4 focus:ring-green-300">Iniciar lavado</button>
                }
                else
                {
                    <div class="inline-flex flex-col items-start sm:items-end">
                        <button type="button" data-turno-inicio disabled title="@motivoInhabilitado" class="inline-flex items-center px-4 py-2 bg-gray-400 dark:bg-gray-600 text-white text-sm font-medium rounded-lg cursor-not-allowed opacity-60">Iniciar lavado</button>
                        <span class="text-xs text-amber-600 dark:text-amber-400 mt-1">@motivoInhabilitado</span>
                    </div>
                }
            }
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <div class="grid gap-4 md:grid-cols-2">
                <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
                    <h2 class="text-md font-semibold text-gray-900 dark:text-white mb-3">Información General</h2>
                    <dl class="space-y-2 text-sm">
                        <div class="flex justify-between gap-4"><dt class="text-gray-600 dark:text-gray-400">Cliente</dt><dd class="font-medium text-gray-900 dark:text-white">@Model.Cliente</dd></div>
                        <div class="flex justify-between gap-4"><dt class="text-gray-600 dark:text-gray-400">Empleados asignados</dt><dd class="font-medium text-gray-900 dark:text-white">@(Model.EmpleadosAsignados?.Count > 0 ? string.Join(", ", Model.EmpleadosAsignados) : "No disponible")</dd></div>
                        <div class="flex justify-between gap-4"><dt class="text-gray-600 dark:text-gray-400">Estado</dt><dd class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-gray-900 dark:text-gray-300">@Model.Estado</dd></div>
                        <div class="flex justify-between gap-4"><dt class="text-gray-600 dark:text-gray-400">Inicio (Buenos Aires)</dt><dd class="font-medium text-gray-900 dark:text-white">@TimeZoneInfo.ConvertTimeFromUtc(Model.InicioUtc, zona).ToString("dd/MM/yyyy HH:mm")</dd></div>
                        <div class="flex justify-between gap-4"><dt class="text-gray-600 dark:text-gray-400">Fin (Buenos Aires)</dt><dd class="font-medium text-gray-900 dark:text-white">@TimeZoneInfo.ConvertTimeFromUtc(Model.FinUtc, zona).ToString("dd/MM/yyyy HH:mm")</dd></div>
                        <div class="flex justify-between gap-4"><dt class="text-gray-600 dark:text-gray-400">Acepta adelanto</dt><dd class="font-medium text-gray-900 dark:text-white">@(Model.AceptaAdelanto ? "Sí" : "No")</dd></div>
                    </dl>
                </div>
                <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
                    <h2 class="text-md font-semibold text-gray-900 dark:text-white mb-3">Precio acordado</h2>
                    <p class="font-bold text-lg text-gray-900 dark:text-white">@Model.PrecioAcordado.ToString("C")</p>
                </div>
            </div>
            @foreach (var vehiculo in Model.Vehiculos)
            {
                <div class="mt-4 bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
                    <h2 class="text-md font-semibold text-gray-900 dark:text-white mb-3">Vehículo: @vehiculo.Patente</h2>
                    <p class="text-sm text-gray-600 dark:text-gray-400">Empleados requeridos: @vehiculo.CantidadEmpleadosRequeridos</p>
                    <h3 class="text-sm font-semibold text-gray-900 dark:text-white mt-4 mb-2">Servicios</h3>
                    <ul class="space-y-2">
                    @foreach (var servicio in vehiculo.Servicios)
                    {
                        <li class="p-2 bg-white dark:bg-gray-600 rounded text-sm text-gray-900 dark:text-white">@servicio.Nombre — @servicio.TiempoEstimado min — @servicio.Precio.ToString("C")</li>
                    }
                    </ul>
                </div>
            }
        </div>
    </div>
</section>
@if (Model.Estado == "Pendiente" && User.TienePermiso("Turnos.Consultar") && User.TienePermiso("Turnos.Cancelar"))
{
    @await Html.PartialAsync("_TurnoCancelacion", Model)
    <script src="~/js/turno-cancelacion.js" asp-append-version="true"></script>
}
@if (Model.Estado == "Pendiente" && User.TienePermiso("Turnos.Consultar") && User.TienePermiso("Turnos.Modificar") && User.TienePermiso("Lavados.Crear") && User.TienePermiso("Lavados.Modificar"))
{
    @await Html.PartialAsync("_TurnoInicio", Model)
    <script src="~/js/turno-inicio.js" asp-append-version="true"></script>
}
