@model Firebase.Models.TurnoConsultaViewModel
<noscript><p class="text-red-700">Para cancelar el turno debe habilitar JavaScript.</p></noscript>
<dialog id="turno-cancelacion-dialog" aria-labelledby="turno-cancelacion-title" aria-describedby="turno-cancelacion-description" class="rounded-lg bg-transparent p-0 w-full max-w-md">
    <div class="relative p-4 text-center bg-white rounded-lg shadow dark:bg-gray-800 sm:p-5">
        <button id="turno-cancelacion-close" type="button" class="text-gray-400 absolute top-2.5 right-2.5 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 ml-auto inline-flex items-center dark:hover:bg-gray-600 dark:hover:text-white">
            <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
            <span class="sr-only">Cerrar modal</span>
        </button>
        <svg class="text-red-400 dark:text-red-500 w-11 h-11 mb-3.5 mx-auto" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
        <h2 id="turno-cancelacion-title" class="mb-2 text-lg font-semibold text-gray-900 dark:text-white">Cancelar turno</h2>
        <p id="turno-cancelacion-description" class="mb-4 text-sm text-gray-500 dark:text-gray-300">¿Está seguro de que desea cancelar este turno?</p>
        <form id="turno-cancelacion-form" method="post" action="@Url.Action("Cancelar", "Turnos")" aria-labelledby="turno-cancelacion-title">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <label for="turno-cancelacion-motivo" class="block mb-2 text-sm text-gray-500 dark:text-gray-300">Por favor, indique el motivo de la cancelación:</label>
            <textarea id="turno-cancelacion-motivo" name="motivo" rows="3" required class="block w-full p-2.5 mb-4 text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" placeholder="Ingrese el motivo de la cancelación..."></textarea>
            <p id="turno-cancelacion-error" aria-live="polite" class="text-red-700 dark:text-red-400 my-3"></p>
            <div class="flex justify-center items-center space-x-4">
                <button id="turno-cancelacion-cancel" type="button" autofocus class="py-2 px-3 text-sm font-medium text-gray-500 bg-white rounded-lg border border-gray-200 hover:bg-gray-100 focus:ring-4 focus:ring-primary-300 hover:text-gray-900 focus:z-10 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-500 dark:hover:text-white dark:hover:bg-gray-600">No, cancelar</button>
                <button id="turno-cancelacion-submit" type="submit" class="py-2 px-3 text-sm font-medium text-center text-white bg-red-600 rounded-lg hover:bg-red-700 focus:ring-4 focus:ring-red-300 dark:bg-red-500 dark:hover:bg-red-600">Sí, confirmar</button>
            </div>
        </form>
    </div>
</dialog>
