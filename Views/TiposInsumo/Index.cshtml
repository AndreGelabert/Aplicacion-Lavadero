@model List<Firebase.Models.TipoInsumo>
@using Firebase.Security
@{
    ViewData["Title"] = "Tipos de insumo";
    var puedeModificar = User.TienePermiso("Insumos.Modificar");
}
<section class="p-4 bg-white dark:bg-gray-800 rounded-lg">
    <div class="flex justify-between mb-4"><h1 class="text-2xl">Tipos de insumo</h1><a asp-controller="Insumos" asp-action="Index">Volver a insumos</a></div>
    @if (User.TienePermiso("Insumos.Crear") && !Model.Any(t => string.Equals(t.Nombre, "Herramienta", StringComparison.OrdinalIgnoreCase)))
    {
        <form method="post" asp-action="InicializarHerramienta" class="mb-4">
            @Html.AntiForgeryToken()
            <p>El tipo protegido Herramienta aún no está disponible.</p>
            <button class="app-button app-button--primary">Inicializar Herramienta</button>
        </form>
    }
    @if (User.TienePermiso("Insumos.Crear"))
    {
        <details class="mb-4"><summary>Nuevo tipo</summary>
            <form method="post" asp-action="Guardar" class="grid md:grid-cols-4 gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="crear" value="true" />
                <input name="Nombre" required maxlength="120" placeholder="Nombre" aria-label="Nombre" />
                <select name="Categoria" aria-label="Categoría"><option value="Volumen">Volumen</option><option value="Masa">Masa</option><option value="Unidades">Unidades</option></select>
                <select name="UnidadResumen" aria-label="Unidad resumen"><option value="ml">ml</option><option value="l">l</option><option value="mg">mg</option><option value="g">g</option><option value="kg">kg</option><option value="unidad">unidad</option></select>
                <button class="app-button app-button--success">Crear tipo</button>
            </form>
        </details>
    }
    <table class="w-full text-left"><thead><tr><th>Nombre</th><th>Categoría</th><th>Unidad resumen</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
    @foreach (var tipo in Model)
    {
        var protegido = tipo.EsProtegido || string.Equals(tipo.Nombre, "Herramienta", StringComparison.OrdinalIgnoreCase);
        <tr><td>@tipo.Nombre</td><td>@tipo.Categoria</td><td>@tipo.UnidadResumen</td><td>@tipo.Estado</td><td>
        @if (puedeModificar && !protegido)
        {
            <details><summary>Editar</summary><form method="post" asp-action="Guardar" class="flex gap-2">
                @Html.AntiForgeryToken()<input type="hidden" name="crear" value="false" /><input type="hidden" name="Id" value="@tipo.Id" />
                <input name="Nombre" value="@tipo.Nombre" required maxlength="120" aria-label="Nombre" />
                <select name="Categoria" aria-label="Categoría"><option value="Volumen" selected="@(tipo.Categoria == "Volumen")">Volumen</option><option value="Masa" selected="@(tipo.Categoria == "Masa")">Masa</option><option value="Unidades" selected="@(tipo.Categoria == "Unidades")">Unidades</option></select>
                <select name="UnidadResumen" aria-label="Unidad resumen">
                    @foreach (var unidad in new[] { "ml", "l", "mg", "g", "kg", "unidad" }) { <option value="@unidad" selected="@(tipo.UnidadResumen == unidad)">@unidad</option> }
                    @if (!new[] { "ml", "l", "mg", "g", "kg", "unidad" }.Contains(tipo.UnidadResumen)) { <option selected value="@tipo.UnidadResumen">@tipo.UnidadResumen</option> }
                </select><button>Guardar</button>
            </form></details>
            <form method="post" asp-action="CambiarEstado">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@tipo.Id" /><input type="hidden" name="estado" value="@(tipo.Estado == "Activo" ? "Inactivo" : "Activo")" /><button>@(tipo.Estado == "Activo" ? "Desactivar" : "Reactivar")</button></form>
            <form method="post" asp-action="Eliminar">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@tipo.Id" /><button>Eliminar</button></form>
        }
        else if (protegido) { <span>Protegido</span> }
        </td></tr>
    }
    </tbody></table>
</section>
