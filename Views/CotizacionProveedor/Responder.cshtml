@{ Layout = null; }
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Cargar cotización de insumos</title>
    <style nonce="@ViewData["Nonce"]">
        :root { color-scheme: light; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; }
        body { margin: 0; background: #f8fafc; color: #0f172a; line-height: 1.5; }
        main { max-width: 720px; margin: 24px auto; padding: 24px; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
        h1 { margin: 0 0 6px; font-size: 1.4rem; }
        .sub { color: #475569; margin: 0 0 20px; font-size: 0.95rem; }
        .meta { background: #f1f5f9; padding: 12px 14px; border-radius: 8px; margin-bottom: 18px; font-size: 0.9rem; }
        .item { border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px; margin-bottom: 14px; }
        .item-title { font-weight: 600; margin-bottom: 10px; }
        .grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
        label { display: block; font-size: 0.875rem; font-weight: 500; }
        input, select { width: 100%; box-sizing: border-box; margin-top: 4px; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.95rem; background: #fff; }
        .preview { margin: 8px 0 0; font-size: 0.82rem; color: #475569; min-height: 1.1em; }
        .total { text-align: right; font-weight: 600; margin: 12px 0; font-size: 1rem; }
        .actions { margin-top: 18px; display: flex; justify-content: flex-end; }
        button { background: #16a34a; color: #fff; border: 0; border-radius: 8px; padding: 10px 18px; font-size: 0.95rem; font-weight: 600; cursor: pointer; }
        button:disabled { opacity: .6; cursor: not-allowed; }
        .status { padding: 12px 14px; border-radius: 8px; margin-top: 12px; }
        .status-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
        .status-ok { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
        .hidden { display: none; }
    </style>
    <script nonce="@ViewData["Nonce"]" src="/js/cotizacion-proveedor.js" defer></script>
</head>
<body>
    <main>
        <h1 id="titulo">Solicitud de cotización</h1>
        <p id="subtitulo" class="sub">Cargando información de la solicitud...</p>
        <div id="meta" class="meta hidden"></div>
        <div id="formulario-contenedor" class="hidden">
            <div id="items-contenedor"></div>
            <p id="total-estimado" class="total"></p>
            <div class="grid">
                <label>Plazo de entrega (días) *
                    <input id="plazo-entrega" type="number" min="0" step="1" placeholder="Ej: 3 (días hábiles)" required>
                </label>
                <label>Notas
                    <input id="notas" type="text" placeholder="Condiciones de validez de oferta...">
                </label>
            </div>
            <div class="actions">
                <button id="enviar" type="button">Enviar cotización</button>
            </div>
        </div>
        <p id="estado" class="status hidden" role="status" aria-live="polite"></p>
        <noscript>Necesita activar JavaScript para cargar su cotización.</noscript>
    </main>
</body>
</html>
