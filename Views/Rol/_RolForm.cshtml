@model Firebase.Models.Rol
@{
    var edit = !string.IsNullOrWhiteSpace(Model?.Id);
    var protegido = RolCatalogo.EsRolProtegido(Model?.Nombre);
    var esAdministrador = protegido && RolReglas.SonNombresIguales(Model?.Nombre, "Administrador");
    var permisos = Model?.Permisos ?? new List<string>();
    var formAction = edit
        ? Url.Action("ActualizarRolAjax", "Rol")
        : Url.Action("CrearRolAjax", "Rol");
    var submitText = edit ? "Guardar Cambios" : "Guardar";
}

<form id="rol-form" data-edit="@(edit ? "true" : "false")" method="post" action="@formAction"
      onsubmit="return submitRolAjax(this, event);">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" id="Id" value="@(Model?.Id)" />

    <div class="grid gap-4 m-4 md:grid-cols-2">
        <!-- Nombre -->
        <div>
            <label for="Nombre" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                Nombre del Rol <span class="text-red-600">*</span>
            </label>
            <input type="text" name="Nombre" id="Nombre" maxlength="50" required
                   class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500 @(protegido ? "bg-gray-100 cursor-not-allowed opacity-70 dark:bg-gray-600" : "")"
                   placeholder="Nombre del rol"
                   value="@(Model?.Nombre)"
                   readonly="@protegido">
            @if (protegido)
            {
                <span class="inline-flex items-center mt-2 px-2 py-0.5 text-xs font-medium text-blue-800 bg-blue-100 rounded dark:bg-blue-900 dark:text-blue-300">
                    Rol Protegido del Sistema
                </span>
            }
            <span data-valmsg-for="Nombre" class="block mt-1 text-red-600 text-xs"></span>
        </div>

        <!-- Descripción -->
        <div>
            <label for="Descripcion" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                Descripción
            </label>
            <textarea name="Descripcion" id="Descripcion" maxlength="250" rows="3"
                      class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
                      placeholder="Descripción del rol (opcional)">@(Model?.Descripcion)</textarea>
            <span data-valmsg-for="Descripcion" class="block mt-1 text-red-600 text-xs"></span>
        </div>
    </div>

    <!-- Matriz de permisos -->
    <div class="m-4">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <label class="block text-sm font-medium text-gray-900 dark:text-white">
                Permisos <span class="text-red-600">*</span>
            </label>
            <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                <input type="checkbox" id="perm-select-all" onchange="seleccionarTodosPermisos(this.checked)"
                       class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600">
                Seleccionar todos
            </label>
        </div>

        <div class="grid gap-3 md:grid-cols-2">
            @foreach (var modulo in RolCatalogo.Modulos)
            {
                <div class="permiso-card border border-gray-200 dark:border-gray-600 rounded-lg p-3 bg-gray-50 dark:bg-gray-700">
                    <h4 class="mb-2 text-sm font-semibold text-gray-900 dark:text-white">@modulo.Nombre</h4>
                    <div class="grid grid-cols-2 gap-2">
                        @foreach (var accion in modulo.Acciones)
                        {
                            var clave = RolCatalogo.Clave(modulo.Clave, accion);
                            var marcado = permisos.Contains(clave);
                            var critico = esAdministrador && string.Equals(modulo.Clave, "Roles", StringComparison.Ordinal);

                            <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                                <input type="checkbox" name="Permisos" value="@clave" id="perm-@modulo.Clave-@accion"
                                       class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:bg-gray-600 dark:border-gray-500"
                                       title="@(critico ? "Permiso crítico del sistema" : "Permiso")"
                                       checked="@marcado"
                                       disabled="@critico">
                                <span>@accion</span>
                            </label>

                            if (critico)
                            {
                                <input type="hidden" name="Permisos" value="@clave" />
                            }
                        }
                    </div>
                </div>
            }
        </div>
        <span data-valmsg-for="Permisos" class="block mt-2 text-red-600 text-xs"></span>
    </div>

    <!-- Mensaje global del formulario -->
    <div id="rol-form-message" class="hidden mx-4 mb-4 p-4 text-sm rounded-lg" role="alert"></div>

    <!-- Botones -->
    <div class="flex justify-end gap-2 m-4">
        <button type="submit"
                class="text-white inline-flex items-center bg-green-600 rounded-lg hover:bg-green-700 focus:ring-4 focus:outline-none focus:ring-green-300 dark:bg-green-500 dark:hover:bg-green-600 dark:focus:ring-green-900 font-medium text-sm px-4 py-2 text-center">
            @submitText
        </button>
        <button type="button" onclick="closeRolForm()"
                class="text-white inline-flex items-center bg-red-600 rounded-lg hover:bg-red-700 focus:ring-4 focus:outline-none focus:ring-red-300 dark:bg-red-500 dark:hover:bg-red-600 dark:focus:ring-red-900 font-medium text-sm px-4 py-2 text-center">
            Cancelar
        </button>
    </div>
</form>
