@model List<Firebase.Models.Rol>
@{
    ViewData["Title"] = "Roles y Permisos";
    var estadoActual = ViewBag.Estado as string ?? string.Empty;
    var sortActual = $"{ViewBag.SortBy ?? "Nombre"}|{ViewBag.SortOrder ?? "asc"}";
}

<section class="bg-gray-50 dark:bg-gray-900">
    <div class="mx-auto bg-white dark:bg-gray-800 relative shadow-md sm:rounded-lg overflow-visible">
        <!-- Encabezado -->
        <div class="p-2 flex flex-wrap gap-2 justify-between items-center rounded-t border-b dark:border-gray-600">
            <h1 class="text-2xl md:block font-semibold text-gray-900 dark:text-white">
                Roles y Permisos
            </h1>
            <div class="flex items-center gap-2 ml-auto">
                <!-- Botón de ayuda -->
                <button data-popover-target="rol-help-popover" data-popover-trigger="click" type="button"
                        class="text-white inline-flex items-center bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-2 py-2 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z"></path>
                    </svg>
                </button>
                <div data-popover id="rol-help-popover" role="tooltip"
                     class="absolute z-10 invisible inline-block w-72 text-sm text-gray-500 transition-opacity duration-300 bg-white border border-gray-200 rounded-lg shadow-sm opacity-0 dark:text-gray-400 dark:border-gray-600 dark:bg-gray-800">
                    <div class="px-3 py-2 bg-gray-100 border-b border-gray-200 rounded-t-lg dark:border-gray-600 dark:bg-gray-700">
                        <h3 class="font-semibold text-gray-900 dark:text-white">Ayuda</h3>
                    </div>
                    <div class="px-3 py-2">
                        <p>En esta página puedes crear, modificar y eliminar roles, y definir qué permisos tiene cada uno sobre los módulos del sistema. Los roles Administrador y Empleado son predeterminados y están protegidos.</p>
                    </div>
                    <div data-popper-arrow></div>
                </div>
            </div>
        </div>

        @if (User.TienePermiso("Roles.Crear") || User.TienePermiso("Roles.Modificar"))
        {
            <!-- Formulario de Registro/Edición -->
            <div id="accordion-flush" data-accordion="collapse" data-active-classes="bg-white dark:bg-gray-900 text-gray-900 dark:text-white" data-inactive-classes="text-gray-500 dark:text-gray-400">
                <h2 id="accordion-flush-heading-1">
                    <button type="button"
                            class="flex items-center justify-between w-full p-2 py-5 font-medium rtl:text-right text-gray-500 border-b border-gray-200 dark:border-gray-700 dark:text-gray-400 gap-3"
                            data-accordion-target="#accordion-flush-body-1"
                            aria-expanded="false"
                            aria-controls="accordion-flush-body-1">
                        <div class="flex items-center gap-2">
                            <span id="rol-form-title">Nuevo Rol</span>
                            <svg data-accordion-icon class="w-3 h-3 rotate-180 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5 5 1 1 5" />
                            </svg>
                        </div>
                    </button>
                </h2>
                <div id="accordion-flush-body-1" class="hidden" aria-labelledby="accordion-flush-heading-1">
                    <div class="py-2 border-b border-gray-200 dark:border-gray-700">
                        <div id="rol-form-container">
                            @if (User.TienePermiso("Roles.Crear"))
                            {
                                @await Html.PartialAsync("_RolForm", new Firebase.Models.Rol())
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Filtros y búsqueda -->
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 p-4 border-b dark:border-gray-600">
            <div class="w-full md:w-1/2">
                <label for="rol-search" class="sr-only">Buscar rol</label>
                <div class="relative w-full md:w-96">
                    <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                        <svg aria-hidden="true" class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <input type="text" id="rol-search" value="@(ViewBag.SearchTerm ?? "")"
                           class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full pl-10 p-2 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
                           placeholder="Buscar rol..." autocomplete="off">
                </div>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
                <div>
                    <label for="rol-estado" class="sr-only">Estado</label>
                    <select id="rol-estado"
                            class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                        <option value="" selected="@(string.IsNullOrEmpty(estadoActual))">Todos</option>
                        <option value="Activo" selected="@(estadoActual == "Activo")">Activo</option>
                        <option value="Inactivo" selected="@(estadoActual == "Inactivo")">Inactivo</option>
                    </select>
                </div>
                <div>
                    <label for="rol-sort" class="sr-only">Ordenar por</label>
                    <select id="rol-sort"
                            class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                        <option value="Nombre|asc" selected="@(sortActual == "Nombre|asc")">Nombre (A-Z)</option>
                        <option value="Nombre|desc" selected="@(sortActual == "Nombre|desc")">Nombre (Z-A)</option>
                        <option value="FechaCreacion|desc" selected="@(sortActual == "FechaCreacion|desc")">Más recientes</option>
                        <option value="Permisos|desc" selected="@(sortActual == "Permisos|desc")">Más permisos</option>
                        <option value="Estado|asc" selected="@(sortActual == "Estado|asc")">Estado</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Tabla de roles -->
        <div id="rol-table-container" data-current-page="@ViewBag.CurrentPage">
            @await Html.PartialAsync("_RolTable", Model)
        </div>
    </div>
</section>

<!-- Modal de confirmación de eliminación -->
<div id="rol-delete-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50 p-4" aria-hidden="true">
    <div class="relative w-full max-w-md bg-white dark:bg-gray-800 rounded-lg shadow-lg p-5 text-center">
        <div class="w-12 h-12 rounded-full bg-red-100 dark:bg-red-900 p-2 flex items-center justify-center mx-auto mb-3.5">
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="w-8 h-8 text-red-600 dark:text-red-400" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm-.75 4.5a.75.75 0 0 1 1.5 0v6a.75.75 0 0 1-1.5 0v-6Zm0 9a.75.75 0 0 1 1.5 0v1.5a.75.75 0 0 1-1.5 0V15.75Z" clip-rule="evenodd" />
            </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Confirmar Eliminación</h3>
        <p id="rol-delete-text" class="text-sm text-gray-600 dark:text-gray-300 mb-4"></p>
        <form id="rol-delete-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="rol-delete-id" />
        </form>
        <div class="flex justify-center items-center space-x-4">
            <button type="button" onclick="closeRolDeleteModal()"
                    class="py-2 px-3 text-sm font-medium text-gray-500 bg-white rounded-lg border border-gray-200 hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-300 hover:text-gray-900 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-500 dark:hover:text-white dark:hover:bg-gray-600">
                Cancelar
            </button>
            <button type="button" id="rol-delete-confirm-btn"
                    class="py-2 px-3 text-sm font-medium text-center text-white bg-red-600 rounded-lg hover:bg-red-700 focus:ring-4 focus:outline-none focus:ring-red-300 dark:bg-red-500 dark:hover:bg-red-600 dark:focus:ring-red-900">
                Confirmar Eliminación
            </button>
        </div>
    </div>
</div>

<!-- Modal de bloqueo -->
<div id="rol-block-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50 p-4" aria-hidden="true">
    <div class="relative w-full max-w-md bg-white dark:bg-gray-800 rounded-lg shadow-lg p-5 text-center">
        <div class="w-12 h-12 rounded-full bg-yellow-100 dark:bg-yellow-900 p-2 flex items-center justify-center mx-auto mb-3.5">
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="w-8 h-8 text-yellow-500 dark:text-yellow-400" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm-.75 4.5a.75.75 0 0 1 1.5 0v6a.75.75 0 0 1-1.5 0v-6Zm0 9a.75.75 0 0 1 1.5 0v1.5a.75.75 0 0 1-1.5 0V15.75Z" clip-rule="evenodd" />
            </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Acción no permitida</h3>
        <p id="rol-block-message" class="text-sm text-gray-600 dark:text-gray-300 mb-4"></p>
        <button type="button" onclick="closeRolBlockModal()"
                class="py-2 px-3 text-sm font-medium text-center text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-500 dark:hover:bg-blue-600 dark:focus:ring-blue-900">
            Entendido
        </button>
    </div>
</div>

<!-- Contenedor de notificaciones -->
<div id="rol-toast-container" class="fixed flex flex-col items-end gap-2"
     style="top: 5rem; right: 1rem; z-index: 60;"
     aria-live="polite" aria-atomic="true"></div>
<template id="rol-toast-template">
    <div class="flex items-center w-full max-w-sm p-4 text-sm rounded-lg shadow-lg" role="status">
        <span data-toast-text></span>
    </div>
</template>

@section Scripts {
    <script src="~/js/roles.js" asp-append-version="true"></script>
}
